---
interface Props {
  category: string;
  icon?: string;
  message?: string;
}

const { 
  category, 
  icon = '🔨',
  message = `Currently crafting new ${category} projects`
} = Astro.props;

// Category-specific icons and messages
const categoryConfig = {
  photography: {
    icon: '📸',
    message: 'Developing new photo collections',
    subtext: 'Processing images in the darkroom of creativity'
  },
  woodworking: {
    icon: '🪵',
    message: 'Crafting new pieces in the workshop',
    subtext: 'Measuring twice, cutting once, creating always'
  },
  leatherwork: {
    icon: '🧵',
    message: 'Stitching new leather goods',
    subtext: 'Hand-crafting pieces that improve with age'
  },
  music: {
    icon: '🎵',
    message: 'Composing new melodies',
    subtext: 'Tuning strings and finding harmonies'
  },
  engineering: {
    icon: '⚡',
    message: 'Building new solutions',
    subtext: 'Coding, soldering, and innovating'
  },
  costuming: {
    icon: '✂️',
    message: 'Designing new costumes',
    subtext: 'Bringing characters to life, one stitch at a time'
  },
  food: {
    icon: '👨‍🍳',
    message: 'Perfecting new recipes',
    subtext: 'Experimenting with flavors and techniques'
  }
};

const config = categoryConfig[category.toLowerCase()] || {
  icon: icon,
  message: message,
  subtext: 'New content coming soon'
};
---

<div class="flex items-center justify-center min-h-[400px] py-12">
  <div class="text-center max-w-md mx-auto">
    <!-- Animated Icon Container -->
    <div class="relative mb-8">
      <!-- Background circles with subtle animation -->
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="w-32 h-32 rounded-full bg-gradient-to-br from-blue-100 to-purple-100 dark:from-blue-900/20 dark:to-purple-900/20 animate-pulse"></div>
      </div>
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="w-24 h-24 rounded-full bg-gradient-to-tr from-pink-100 to-yellow-100 dark:from-pink-900/20 dark:to-yellow-900/20 animate-pulse" style="animation-delay: 0.5s;"></div>
      </div>
      
      <!-- Main icon -->
      <div class="relative w-32 h-32 mx-auto rounded-full bg-white dark:bg-gray-800 shadow-lg flex items-center justify-center transform hover:scale-105 transition-transform duration-300 animate-wobble">
        <span class="text-5xl">{config.icon}</span>
      </div>
    </div>

    <!-- Text Content -->
    <h3 class="text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-3">
      {config.message}
    </h3>
    <p class="text-gray-600 dark:text-gray-400 mb-6">
      {config.subtext}
    </p>

    <!-- Progress Indicator -->
    <div class="flex items-center justify-center gap-2 mb-8">
      <div class="w-2 h-2 rounded-full bg-blue-500 animate-bounce" style="animation-delay: 0s;"></div>
      <div class="w-2 h-2 rounded-full bg-purple-500 animate-bounce" style="animation-delay: 0.2s;"></div>
      <div class="w-2 h-2 rounded-full bg-pink-500 animate-bounce" style="animation-delay: 0.4s;"></div>
    </div>

    <!-- CTA -->
    <div class="space-y-3">
      <p class="text-sm text-gray-500 dark:text-gray-500">
        Want to see what's coming?
      </p>
      <a href="/contact" class="inline-flex items-center gap-2 text-blue-600 dark:text-blue-400 hover:text-purple-600 dark:hover:text-purple-400 transition-colors group">
        <span>Get notified when new projects arrive</span>
        <svg class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
        </svg>
      </a>
    </div>
  </div>
</div>

<style>
  @keyframes wobble {
    0%, 100% {
      transform: rotate(-3deg);
    }
    50% {
      transform: rotate(3deg);
    }
  }
  
  .animate-wobble {
    animation: wobble 4s ease-in-out infinite;
    transform-origin: center center;
  }
</style>