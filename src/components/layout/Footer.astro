---
const currentYear = new Date().getFullYear();

const socialLinks = [
  { 
    name: 'LinkedIn', 
    href: 'https://www.linkedin.com/in/bryantfhayes/',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`
  },
  { 
    name: 'GitHub', 
    href: 'https://github.com/bfhayes',
    icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.30.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>`
  },
  { 
    name: 'Email', 
    href: 'mailto:bryant.hayes@icloud.com',
    icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>`
  }
];

const quickLinks = [
  { href: '/work', label: 'Work' },
  { href: '/photography', label: 'Photography' },
  { href: '/woodworking', label: 'Woodworking' },
  { href: '/contact', label: 'Contact' },
];
---

<footer class="border-t border-rose-quartz/20 bg-isabelline-100/50 mt-20">
  <div class="container-custom py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- Brand -->
      <div class="md:col-span-2">
        <div class="flex items-center space-x-2 mb-4">
          <div class="h-8 w-8 rounded-md bg-space-cadet flex items-center justify-center">
            <span class="text-isabelline font-bold text-lg">BH</span>
          </div>
          <span class="font-serif text-xl font-semibold text-space-cadet">
            Bryant Hayes
          </span>
        </div>
        <p class="text-sm text-ultra-violet-600 max-w-md">
          Maker of things with code, wood, leather, cameras, and more. 
          Showcasing professional work and creative pursuits.
        </p>
      </div>

      <!-- Quick Links -->
      <div>
        <h3 class="font-semibold text-space-cadet mb-3">Quick Links</h3>
        <ul class="space-y-2">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-sm text-ultra-violet-600 hover:text-ultra-violet transition-colors"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Connect -->
      <div>
        <h3 class="font-semibold text-space-cadet mb-3">Connect</h3>
        <div class="flex space-x-3">
          {socialLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-md bg-ultra-violet/10 hover:bg-ultra-violet/20 text-ultra-violet-600 hover:text-ultra-violet transition-all"
              aria-label={link.name}
            >
              <Fragment set:html={link.icon} />
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-8 pt-8 border-t border-rose-quartz/20">
      <div class="flex flex-col sm:flex-row justify-between items-center space-y-2 sm:space-y-0">
        <p class="text-xs text-ultra-violet-600">
          &copy; {currentYear} Bryant Hayes. All rights reserved.
        </p>
        <p class="text-xs text-ultra-violet-600">
          Built with <span class="text-pale-dogwood">♥</span> using Astro & Tailwind CSS
        </p>
      </div>
    </div>
  </div>
</footer>