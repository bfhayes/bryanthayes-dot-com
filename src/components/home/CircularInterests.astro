---
export interface Props {
  interests: Array<{
    title: string;
    description: string;
    href: string;
    icon: string;
  }>;
}

const { interests } = Astro.props;

// Calculate positions for circular layout
const calculatePosition = (index: number, total: number) => {
  const angle = (360 / total) * index - 90; // Start from top (-90 degrees)
  const radians = (angle * Math.PI) / 180;
  const radius = 45; // Percentage from center
  const x = 50 + radius * Math.cos(radians);
  const y = 50 + radius * Math.sin(radians);
  return { x, y, angle: angle + 90 };
};
---

<div class="circular-interests-container">
  <!-- Desktop Circular Layout -->
  <div class="hidden lg:block relative w-full max-w-[800px] mx-auto aspect-square">
    <!-- Background decoration -->
    <div class="absolute inset-0">
      <!-- Outer ring -->
      <div class="absolute inset-[10%] rounded-full border border-gray-200 dark:border-gray-700 opacity-30"></div>
      <!-- Middle ring -->
      <div class="absolute inset-[25%] rounded-full border border-gray-200 dark:border-gray-700 opacity-20"></div>
      <!-- Inner ring -->
      <div class="absolute inset-[40%] rounded-full border border-gray-200 dark:border-gray-700 opacity-10"></div>
    </div>

    <!-- Central Hub -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20">
      <div class="relative group">
        <div class="absolute inset-0 bg-gradient-to-r from-blue-500 to-purple-500 rounded-full blur-xl opacity-30 group-hover:opacity-50 transition-opacity duration-500"></div>
        <div class="relative w-32 h-32 bg-white dark:bg-gray-800 rounded-full shadow-2xl flex flex-col items-center justify-center border-2 border-gray-100 dark:border-gray-700">
          <span class="text-2xl font-serif font-bold text-gray-900 dark:text-gray-100">What</span>
          <span class="text-2xl font-serif font-bold text-gray-900 dark:text-gray-100">I Do</span>
        </div>
      </div>
    </div>

    <!-- Interest Items -->
    {interests.map((interest, index) => {
      const pos = calculatePosition(index, interests.length);
      return (
        <a
          href={interest.href}
          class="interest-item absolute w-28 h-28 -ml-14 -mt-14 group"
          style={`left: ${pos.x}%; top: ${pos.y}%; animation-delay: ${index * 100}ms;`}
        >
          <!-- Item container -->
          <div class="relative bg-white dark:bg-gray-800 rounded-full shadow-lg hover:shadow-2xl transition-all duration-300 w-full h-full flex flex-col items-center justify-center p-3 hover:scale-110 hover:z-30">
            <!-- Gradient overlay on hover -->
            <div class="absolute inset-0 bg-gradient-to-br from-blue-500/0 via-purple-500/0 to-pink-500/0 group-hover:from-blue-500/10 group-hover:via-purple-500/10 group-hover:to-pink-500/10 rounded-full transition-all duration-300"></div>
            
            <!-- Content -->
            <div class="relative z-10 text-center">
              <div class="text-3xl mb-1">{interest.icon}</div>
              <h3 class="text-xs font-semibold text-gray-900 dark:text-gray-100 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 transition-all duration-300">
                {interest.title}
              </h3>
            </div>
            
            <!-- Expanded info on hover -->
            <div class="absolute -bottom-20 left-1/2 -translate-x-1/2 w-48 bg-gray-900 dark:bg-gray-100 text-white dark:text-gray-900 p-3 rounded-lg opacity-0 group-hover:opacity-100 transition-all duration-300 pointer-events-none z-40 shadow-xl">
              <p class="text-xs text-center">{interest.description}</p>
              <div class="absolute -top-2 left-1/2 -translate-x-1/2 w-4 h-4 bg-gray-900 dark:bg-gray-100 rotate-45"></div>
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <!-- Tablet Semi-Circle Layout -->
  <div class="hidden md:block lg:hidden">
    <div class="grid grid-cols-3 gap-4 max-w-2xl mx-auto">
      {interests.map((interest, index) => (
        <a
          href={interest.href}
          class="group block transform transition-all duration-300 hover:-translate-y-1"
          style={`animation-delay: ${index * 50}ms;`}
        >
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 p-6 text-center">
            <div class="w-16 h-16 mx-auto mb-3 rounded-full bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-600 flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
              <span class="text-3xl">{interest.icon}</span>
            </div>
            <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2">{interest.title}</h3>
            <p class="text-xs text-gray-600 dark:text-gray-400">{interest.description}</p>
          </div>
        </a>
      ))}
    </div>
  </div>

  <!-- Mobile Carousel/Stack -->
  <div class="md:hidden">
    <div class="space-y-4">
      {interests.map((interest, index) => (
        <a
          href={interest.href}
          class="group block transform transition-all duration-300 hover:-translate-y-1"
          style={`animation-delay: ${index * 50}ms;`}
        >
          <div class="bg-white dark:bg-gray-800 rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 p-6 flex items-center space-x-4">
            <div class="w-14 h-14 rounded-full bg-gradient-to-br from-gray-100 to-gray-200 dark:from-gray-700 dark:to-gray-600 flex items-center justify-center flex-shrink-0 group-hover:scale-110 transition-transform duration-300">
              <span class="text-2xl">{interest.icon}</span>
            </div>
            <div>
              <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-1">{interest.title}</h3>
              <p class="text-sm text-gray-600 dark:text-gray-400">{interest.description}</p>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</div>

<style>
  @keyframes fadeInRotate {
    from {
      opacity: 0;
      transform: scale(0.8) rotate(-10deg);
    }
    to {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  @keyframes pulse-glow {
    0%, 100% {
      box-shadow: 0 0 20px rgba(139, 92, 246, 0.1);
    }
    50% {
      box-shadow: 0 0 40px rgba(139, 92, 246, 0.2);
    }
  }

  .interest-item {
    animation: fadeInRotate 0.6s ease-out forwards;
    opacity: 0;
  }

  .circular-interests-container {
    @apply relative;
  }

  /* Static rings - no rotation animation */
</style>