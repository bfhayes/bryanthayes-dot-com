---
import { getCollection } from 'astro:content';
import EnhancedHero from './EnhancedHero.astro';
import CircularInterests from './CircularInterests.astro';

// Get recent projects from ALL collections
const allCollections = [
  { name: 'woodworking', label: 'Woodworking' },
  { name: 'photography', label: 'Photography' },
  { name: 'leatherwork', label: 'Leatherwork' },
  { name: 'music', label: 'Music' },
  { name: 'engineering', label: 'Engineering' },
  { name: 'games', label: 'Games' },
  { name: 'costuming', label: 'Costuming' },
  { name: 'food', label: 'Food' }
];

// Get most recent project from each collection
const recentHighlights = [];

for (const collection of allCollections) {
  try {
    const projects = await getCollection(collection.name);
    const recentProject = projects
      .filter(p => !p.data.draft && !p.data.hidden)
      .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime())[0];
    
    if (recentProject) {
      recentHighlights.push({
        title: recentProject.data.title,
        category: collection.label,
        image: recentProject.data.heroImage,
        href: `/${collection.name}/${recentProject.slug}`,
        publishDate: recentProject.data.publishDate
      });
    }
  } catch (error) {
    // Skip collections that don't exist or have no content
    console.warn(`Could not load collection ${collection.name}:`, error);
  }
}

// Sort all recent highlights by date and take top 4 most recent
recentHighlights.sort((a, b) => new Date(b.publishDate).getTime() - new Date(a.publishDate).getTime());
recentHighlights.splice(4); // Keep only top 4 most recent

// Unified homepage that showcases all interests equally
const interests = [
  {
    title: 'Work',
    description: 'Professional development & career',
    href: '/work',
    icon: '💼'
  },
  {
    title: 'Photography',
    description: 'Landscapes, portraits & street photography',
    href: '/photography',
    icon: '📷'
  },
  {
    title: 'Woodworking',
    description: 'Furniture & handcrafted pieces',
    href: '/woodworking',
    icon: '🪵'
  },
  {
    title: 'Leatherwork',
    description: 'Custom bags, wallets & accessories',
    href: '/leatherwork',
    icon: '👜'
  },
  {
    title: 'Music',
    description: 'Guitar compositions & recordings',
    href: '/music',
    icon: '🎸'
  },
  {
    title: 'Engineering',
    description: 'Software development, embedded systems & circuit design',
    href: '/engineering',
    icon: '⚙️'
  },
  {
    title: 'Games',
    description: 'HTML5 games & interactive experiences',
    href: '/games',
    icon: '🎮'
  },
  {
    title: 'Costuming',
    description: 'Halloween costumes, cosplay & character design',
    href: '/costuming',
    icon: '🎭'
  },
  {
    title: 'Food',
    description: 'Recipes, BBQ & culinary experiments',
    href: '/food',
    icon: '🍖'
  }
];
---

<div class="min-h-screen">
  <!-- Enhanced Hero Section -->
  <EnhancedHero />

  <!-- Interests Grid -->
  <section class="container-custom py-20">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-4">
        What I Do
      </h2>
      <p class="text-xl text-gray-700 dark:text-gray-300 max-w-2xl mx-auto">
        Every interest teaches me something different. Explore what I'm working on and learning about.
      </p>
    </div>

    <CircularInterests interests={interests} />
  </section>

  <!-- Recent Highlights -->
  {recentHighlights.length > 0 && (
  <section class="bg-gray-50 dark:bg-gray-900 py-20">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-4">
          Recent Highlights
        </h2>
        <p class="text-xl text-gray-700 dark:text-gray-300">
          Latest work from across all my interests
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {recentHighlights.map((item, index) => (
          <a 
            href={item.href} 
            class="group block transform transition-all duration-300 hover:-translate-y-1"
            style={`animation: fade-in-scale 0.6s ease-out ${index * 150}ms both`}
          >
            <div class="relative bg-white dark:bg-gray-800 rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300">
              <!-- Image container with overlay effect -->
              <div class="relative h-48 overflow-hidden bg-gradient-to-br from-gray-100 to-gray-200">
                {item.image ? (
                  <>
                    <img 
                      src={item.image} 
                      alt={item.title}
                      class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
                    />
                    <!-- Gradient overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                  </>
                ) : (
                  <div class="w-full h-full bg-gradient-to-br from-blue-100 via-purple-100 to-pink-100 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                    <span class="text-5xl opacity-40 group-hover:opacity-60 transition-opacity">✨</span>
                  </div>
                )}
                
                <!-- Category badge -->
                <div class="absolute top-4 left-4 px-3 py-1 bg-white/90 backdrop-blur-sm rounded-full text-xs font-medium text-gray-700 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                  {item.category}
                </div>
              </div>
              
              <!-- Content -->
              <div class="p-4">
                <h3 class="font-semibold text-gray-900 dark:text-gray-100 mb-1 line-clamp-2 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-blue-600 group-hover:to-purple-600 transition-all duration-300">
                  {item.title}
                </h3>
                <div class="flex items-center justify-between">
                  <p class="text-sm text-gray-500 dark:text-gray-400">{item.category}</p>
                  <svg class="w-5 h-5 text-gray-400 group-hover:text-blue-600 transform group-hover:translate-x-1 transition-all duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12">
        <p class="text-gray-700 dark:text-gray-300 mb-6">
          Want to see more? Explore any of the sections above to dive deeper.
        </p>
        <a href="/contact" class="btn-primary">
          Get In Touch
        </a>
      </div>
    </div>
  </section>
  )}

  <!-- Philosophy Section -->
  <section class="container-custom py-20">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl lg:text-4xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-8">
        Why I Build Stuff
      </h2>
      <div class="prose prose-lg mx-auto text-gray-700 dark:text-gray-300">
        <p class="text-xl leading-relaxed">
          Whether I'm fixing a bug, cutting wood joints, or framing a shot—it's all the same process: 
          figure out the problem, grab the right tools, try stuff until it works.
        </p>
        <p class="text-lg leading-relaxed mt-6">
          Everything connects. Woodworking taught me patience for debugging. Photography made me pickier about details. 
          Coding logic applies everywhere.
        </p>
      </div>
    </div>
  </section>
</div>