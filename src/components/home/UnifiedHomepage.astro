---
// Unified homepage that showcases all interests equally
const interests = [
  {
    title: 'Work',
    description: 'Professional development & career',
    href: '/work',
    icon: '💼',
    recent: 'Full-stack web applications'
  },
  {
    title: 'Photography',
    description: 'Landscapes, portraits & street photography',
    href: '/photography',
    icon: '📷',
    recent: 'Mountain sunrise series'
  },
  {
    title: 'Woodworking',
    description: 'Furniture & handcrafted pieces',
    href: '/woodworking',
    icon: '🪵',
    recent: 'Live edge oak coffee table'
  },
  {
    title: 'Leatherwork',
    description: 'Custom bags, wallets & accessories',
    href: '/leatherwork',
    icon: '👜',
    recent: 'Minimalist wallet design'
  },
  {
    title: 'Music',
    description: 'Guitar compositions & recordings',
    href: '/music',
    icon: '🎸',
    recent: 'Acoustic fingerstyle pieces'
  },
  {
    title: 'Electronics',
    description: 'DIY projects & circuit design',
    href: '/electronics',
    icon: '⚡',
    recent: 'Arduino weather station'
  },
  {
    title: 'Programming',
    description: 'Personal projects & open source',
    href: '/programming',
    icon: '💻',
    recent: 'Web development tools'
  },
  {
    title: 'Golf',
    description: 'Course reviews & improvement journey',
    href: '/golf',
    icon: '⛳',
    recent: 'Swing analysis & tips'
  }
];

const recentHighlights = [
  { title: 'Oak Coffee Table', category: 'Woodworking', image: '/images/projects/oak-table-thumb.jpg' },
  { title: 'Mountain Sunrise', category: 'Photography', image: '/images/photography/mountain-sunrise-thumb.jpg' },
  { title: 'Minimalist Wallet', category: 'Leatherwork', image: '/images/projects/wallet-thumb.jpg' },
  { title: 'E-Commerce Platform', category: 'Work', image: '/images/projects/ecommerce-thumb.jpg' },
];
---

<div class="min-h-screen">
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-gray-50">
    <div class="absolute inset-0"></div>
    
    <div class="container-custom relative py-20 lg:py-32">
      <div class="max-w-4xl mx-auto text-center">
        <!-- Greeting -->
        <div class="mb-6 animate-slide-down">
          <span class="inline-block px-4 py-2 text-sm font-medium rounded-full bg-gray-200 text-gray-900">
            Welcome to my world
          </span>
        </div>
        
        <!-- Main heading -->
        <h1 class="text-5xl lg:text-7xl font-serif font-bold mb-6 animate-fade-in">
          <span class="block text-gray-900">Bryant Hayes</span>
          <span class="block text-3xl lg:text-5xl mt-4 text-gray-700">
            Maker of Things
          </span>
        </h1>
        
        <!-- Subtitle -->
        <p class="text-xl text-gray-700 mb-10 animate-slide-up max-w-3xl mx-auto">
          I build with code, craft with wood, capture with cameras, and create with my hands. 
          Each pursuit teaches me something new about problem-solving, patience, and the art of making.
        </p>
        
        <!-- Quick links -->
        <div class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up">
          <a href="/work" class="btn-primary">
            View Professional Work
          </a>
          <a href="/photography" class="btn-secondary">
            Browse Photography
          </a>
          <a href="/woodworking" class="btn-ghost">
            See Craftsmanship
          </a>
        </div>
      </div>
      
      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </div>
  </section>

  <!-- Interests Grid -->
  <section class="container-custom py-20">
    <div class="text-center mb-16">
      <h2 class="text-3xl lg:text-4xl font-serif font-bold text-gray-900 mb-4">
        What I Do
      </h2>
      <p class="text-xl text-gray-700 max-w-2xl mx-auto">
        Every interest teaches me something different. Explore what I'm working on and learning about.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {interests.map((interest) => (
        <a href={interest.href} class="group">
          <article class="card p-6 text-center hover:shadow-xl transition-all duration-300 h-full">
            <div class="w-16 h-16 mx-auto mb-4 rounded-full bg-gradient-to-br from-pale-dogwood/30 to-rose-quartz/30 flex items-center justify-center group-hover:scale-110 transition-transform">
              <span class="text-3xl">{interest.icon}</span>
            </div>
            <h3 class="text-xl font-serif font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
              {interest.title}
            </h3>
            <p class="text-sm text-gray-600 mb-3">
              {interest.description}
            </p>
            <div class="text-xs text-gray-500 bg-gray-100 rounded-full px-3 py-1">
              Recent: {interest.recent}
            </div>
          </article>
        </a>
      ))}
    </div>
  </section>

  <!-- Recent Highlights -->
  <section class="bg-gray-50 py-20">
    <div class="container-custom">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-serif font-bold text-gray-900 mb-4">
          Recent Highlights
        </h2>
        <p class="text-xl text-gray-700">
          Latest work from across all my interests
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {recentHighlights.map((item) => (
          <div class="card overflow-hidden hover:shadow-lg transition-all group">
            <div class="aspect-w-16 aspect-h-12 bg-gradient-to-br from-pale-dogwood/20 to-rose-quartz/20 overflow-hidden">
              <div class="w-full h-48 bg-gradient-to-br from-pale-dogwood/30 to-rose-quartz/30 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                <span class="text-4xl opacity-60">✨</span>
              </div>
            </div>
            <div class="p-4">
              <h3 class="font-semibold text-gray-900 mb-1 group-hover:text-blue-600 transition-colors">
                {item.title}
              </h3>
              <p class="text-sm text-gray-600">{item.category}</p>
            </div>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <p class="text-gray-700 mb-6">
          Want to see more? Explore any of the sections above to dive deeper.
        </p>
        <a href="/contact" class="btn-primary">
          Get In Touch
        </a>
      </div>
    </div>
  </section>

  <!-- Philosophy Section -->
  <section class="container-custom py-20">
    <div class="max-w-4xl mx-auto text-center">
      <h2 class="text-3xl lg:text-4xl font-serif font-bold text-gray-900 mb-8">
        Why I Make Things
      </h2>
      <div class="prose prose-lg mx-auto text-gray-700">
        <p class="text-xl leading-relaxed">
          Whether I'm debugging code, hand-cutting dovetail joints, or composing a photograph, 
          the process is similar: understanding the problem, choosing the right tools, 
          and iterating until it's right.
        </p>
        <p class="text-lg leading-relaxed mt-6">
          Each pursuit informs the others. The patience learned in woodworking helps with complex coding problems. 
          The attention to detail from photography improves my craftsmanship. 
          The problem-solving from programming applies everywhere.
        </p>
      </div>
    </div>
  </section>
</div>