---
export interface Props {
  mode: 'professional' | 'creative';
}

const { mode } = Astro.props;

const professionalTitle = "Software Developer";
const professionalSubtitle = "Building elegant solutions to complex problems";

const creativeTitle = "Creative Professional";
const creativeSubtitle = "Exploring craftsmanship through diverse mediums";
---

<section class="relative overflow-hidden">
  <!-- Background gradient -->
  <div class={`absolute inset-0 ${mode === 'professional' ? 'professional-gradient' : 'creative-gradient'} opacity-5`}></div>
  
  <!-- Noise texture -->
  <div class="absolute inset-0 noise"></div>
  
  <div class="container-custom relative py-20 lg:py-32">
    <div class="max-w-4xl mx-auto text-center">
      <!-- Animated greeting -->
      <div class="mb-6 animate-slide-down">
        <span class="inline-block px-4 py-2 text-sm font-medium rounded-full bg-pale-dogwood/20 text-space-cadet">
          Welcome to my {mode === 'professional' ? 'portfolio' : 'creative space'}
        </span>
      </div>
      
      <!-- Main heading -->
      <h1 class="text-5xl lg:text-7xl font-serif font-bold mb-6 animate-fade-in">
        <span class="block text-space-cadet">Bryant Hayes</span>
        <span class={`block text-3xl lg:text-5xl mt-4 ${mode === 'professional' ? 'text-gradient' : 'text-gradient-creative'}`}>
          {mode === 'professional' ? professionalTitle : creativeTitle}
        </span>
      </h1>
      
      <!-- Subtitle -->
      <p class="text-xl text-ultra-violet-600 mb-10 animate-slide-up">
        {mode === 'professional' ? professionalSubtitle : creativeSubtitle}
      </p>
      
      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up">
        {mode === 'professional' ? (
          <>
            <a href="/resume" class="btn-primary">
              View Resume
            </a>
            <a href="/projects" class="btn-secondary">
              Browse Projects
            </a>
            <a href="https://www.linkedin.com/in/bryantfhayes/" target="_blank" rel="noopener" class="btn-ghost">
              <svg class="w-5 h-5 mr-2" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              LinkedIn
            </a>
          </>
        ) : (
          <>
            <a href="/hobbies/photography" class="btn-primary">
              View Photography
            </a>
            <a href="/hobbies" class="btn-secondary">
              Explore All Hobbies
            </a>
            <a href="/about" class="btn-ghost">
              Learn More About Me
            </a>
          </>
        )}
      </div>
    </div>
    
    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-ultra-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </div>
</section>