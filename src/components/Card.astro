---
interface Props {
  class?: string;
  padding?: boolean;
  hover?: boolean;
  background?: string;
  animated?: boolean;
  glow?: boolean;
}

const {
  class: className = '',
  padding = true,
  hover = false,
  background,
  animated = false,
  glow = false,
  ...rest
} = Astro.props;

const classes = [
  'card',
  hover ? 'transition-all duration-300 hover:shadow-lg hover:-translate-y-1 hover:scale-[1.02]' : '',
  animated ? 'animate-scale-on-hover' : '',
  glow ? 'animate-glow' : '',
  'transform transition-transform',
  className,
].filter(Boolean).join(' ');
---

<div class={classes} {...rest}>
  <div class={padding ? 'card-body' : ''}>
    <slot />
  </div>
</div>