---
interface Props {
  title: string;
  subtitle?: string;
  breadcrumb?: Array<{ label: string; href?: string }>;
  class?: string;
}

const {
  title,
  subtitle,
  breadcrumb,
  class: className = '',
} = Astro.props;
---

<div class={`py-8 lg:py-12 ${className}`}>
  {breadcrumb && (
    <nav aria-label="Breadcrumb" class="mb-4">
      <ol class="flex items-center space-x-2 text-sm text-neutral-600">
        {breadcrumb.map((item, index) => (
          <li class="flex items-center">
            {index > 0 && (
              <svg class="h-4 w-4 mx-2 text-neutral-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
              </svg>
            )}
            {item.href ? (
              <a href={item.href} class="hover:text-brand-700 transition-colors">
                {item.label}
              </a>
            ) : (
              <span class="text-neutral-900 font-medium" aria-current="page">
                {item.label}
              </span>
            )}
          </li>
        ))}
      </ol>
    </nav>
  )}
  
  <h1 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-neutral-900 text-balance">
    {title}
  </h1>
  
  {subtitle && (
    <p class="mt-4 text-lg lg:text-xl text-neutral-600 text-balance max-w-3xl">
      {subtitle}
    </p>
  )}
</div>