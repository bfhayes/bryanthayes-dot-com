---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectTile from '@/components/projects/ProjectTile.astro';

// Get all music projects from content collections
const allProjects = await getCollection('music', ({ data }) => !data.draft);
---

<BaseLayout 
  title="Music" 
  description="Guitar compositions and acoustic performances"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Music
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Guitar compositions, fingerstyle arrangements, and acoustic recordings. 
        Exploring melody, harmony, and the art of musical expression.
      </p>
    </div>

    {allProjects.length > 0 ? (
      <!-- Projects Grid -->
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {allProjects.map((project) => (
            <ProjectTile project={project} category="music" />
          ))}
        </div>
      </section>
    ) : (
      <div class="text-center">
        <div class="w-32 h-32 mx-auto mb-8 rounded-full bg-gray-100 flex items-center justify-center">
          <span class="text-6xl opacity-60">🎸</span>
        </div>
        <p class="text-gray-600 mb-8">
          Content coming soon. Check back for original compositions and recordings.
        </p>
        <a href="/contact" class="btn-primary">
          Get In Touch
        </a>
      </div>
    )}

    <!-- Commission -->
    <section class="bg-gray-50 border border-gray-200 rounded-lg p-6 text-center">
      <h2 class="text-xl font-serif font-semibold mb-3 text-gray-900">Interested in Musical Collaboration?</h2>
      <p class="text-base mb-6 text-gray-600">
        Let's discuss custom compositions or performance opportunities.
      </p>
      <a href="/contact" class="btn-primary text-sm px-6 py-2">
        Get In Touch
      </a>
    </section>
  </div>
</BaseLayout>