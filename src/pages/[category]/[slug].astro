---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CATEGORIES, type CategoryKey } from '@/content/config';

export async function getStaticPaths() {
  const paths = [];
  
  // Define valid categories
  const validCategories = Object.keys(CATEGORIES);
  
  // Generate paths for all hobby categories
  for (const category of validCategories) {
    try {
      const collection = await getCollection(category as keyof typeof import('@/content/config').collections);
      
      for (const entry of collection) {
        if (!entry.data.draft) {
          paths.push({
            params: { 
              category: category,
              slug: entry.slug 
            },
            props: { 
              project: entry,
              category: category,
              categoryInfo: CATEGORIES[category as CategoryKey]
            },
          });
        }
      }
    } catch (error) {
      console.warn(`Could not load collection for ${category}:`, error);
    }
  }
  
  return paths;
}

interface Props {
  project: CollectionEntry<any>;
  category: string;
  categoryInfo: typeof CATEGORIES[CategoryKey];
}

const { project, category, categoryInfo } = Astro.props;

if (!project) {
  return Astro.redirect('/404');
}

// Get other projects from the same category for "more projects" section
let relatedProjects: CollectionEntry<any>[] = [];
try {
  const allProjects = await getCollection(category as keyof typeof import('@/content/config').collections);
  relatedProjects = allProjects
    .filter(p => p.slug !== project.slug && !p.data.draft)
    .slice(0, 2);
} catch (error) {
  console.warn(`Could not load related projects for ${category}:`, error);
}

const { Content } = await project.render();
---

<BaseLayout 
  title={project.data.title}
  description={project.data.description}
>
  <div class="container-custom py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 mb-6">
      <a href="/" class="hover:text-gray-900">Home</a>
      <span class="mx-2">/</span>
      <a href={`/${category}`} class="hover:text-gray-900 capitalize">{categoryInfo.label}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900">{project.data.title}</span>
    </nav>

    <!-- Hero Section -->
    <div class="mb-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Hero Image -->
        <div class="aspect-w-4 aspect-h-3">
          {project.data.heroImage ? (
            <img 
              src={project.data.heroImage} 
              alt={project.data.title}
              class="w-full h-96 object-cover rounded-lg"
            />
          ) : (
            <div class="w-full h-96 bg-gradient-to-br from-pale-dogwood/30 to-rose-quartz/30 rounded-lg flex items-center justify-center">
              <span class="text-6xl opacity-60">{categoryInfo.icon}</span>
            </div>
          )}
        </div>
        
        <!-- Title and Metadata -->
        <div class="lg:pl-8">
          <h1 class="text-4xl lg:text-5xl font-serif font-bold text-gray-900 mb-4">
            {project.data.title}
          </h1>
          <p class="text-xl text-gray-700 mb-8">
            {project.data.description}
          </p>
          
          <!-- Category-specific Quick Stats -->
          {category === 'woodworking' && (
            <div class="grid grid-cols-3 gap-4">
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-2xl font-bold text-gray-900">{project.data.difficulty}</div>
                <div class="text-sm text-gray-600">Difficulty</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-2xl font-bold text-gray-900">{project.data.duration}</div>
                <div class="text-sm text-gray-600">Duration</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-2xl font-bold text-gray-900">{project.data.materials?.length || 0}</div>
                <div class="text-sm text-gray-600">Materials</div>
              </div>
            </div>
          )}

          {category === 'leatherwork' && (
            <div class="grid grid-cols-3 gap-4">
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-2xl font-bold text-gray-900 capitalize">{project.data.type}</div>
                <div class="text-sm text-gray-600">Type</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-2xl font-bold text-gray-900">{project.data.difficulty}</div>
                <div class="text-sm text-gray-600">Difficulty</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-2xl font-bold text-gray-900">{project.data.duration}</div>
                <div class="text-sm text-gray-600">Duration</div>
              </div>
            </div>
          )}

          {category === 'photography' && (
            <div class="grid grid-cols-2 gap-4">
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-lg font-bold text-gray-900 capitalize">{project.data.category}</div>
                <div class="text-sm text-gray-600">Category</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-lg font-bold text-gray-900">{project.data.camera || 'Camera'}</div>
                <div class="text-sm text-gray-600">Equipment</div>
              </div>
            </div>
          )}

          {(category === 'engineering' || category === 'costuming' || category === 'music' || category === 'food') && (
            <div class="grid grid-cols-2 gap-4">
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-lg font-bold text-gray-900 capitalize">{project.data.type}</div>
                <div class="text-sm text-gray-600">Type</div>
              </div>
              <div class="text-center p-4 bg-gray-50 rounded-lg">
                <div class="text-lg font-bold text-gray-900">
                  {project.data.difficulty || project.data.status || project.data.duration || 'Details'}
                </div>
                <div class="text-sm text-gray-600">
                  {project.data.difficulty ? 'Difficulty' : project.data.status ? 'Status' : 'Duration'}
                </div>
              </div>
            </div>
          )}
        </div>
      </div>
    </div>

    <!-- Project Gallery -->
    {project.data.gallery && project.data.gallery.length > 0 && (
      <section class="mb-16">
        <h2 class="text-3xl font-serif font-semibold text-gray-900 mb-8">Project Gallery</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {project.data.gallery.map((image: string, index: number) => (
            <div class="aspect-w-4 aspect-h-3 bg-gray-100 rounded-lg overflow-hidden">
              <img 
                src={image} 
                alt={`${project.data.title} - Image ${index + 1}`}
                class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300"
              />
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Project Content (Markdown) -->
    <section class="mb-16">
      <div class="max-w-4xl mx-auto prose prose-lg max-w-none">
        <Content />
      </div>
    </section>

    <!-- Category-specific details sections -->
    {category === 'woodworking' && project.data.materials && (
      <section class="mb-16">
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div>
              <h3 class="text-2xl font-serif font-semibold text-gray-900 mb-6">Materials Used</h3>
              <ul class="space-y-3">
                {project.data.materials.map((material: string) => (
                  <li class="flex items-center text-gray-700">
                    <span class="w-2 h-2 bg-gray-400 rounded-full mr-3"></span>
                    {material}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-2xl font-serif font-semibold text-gray-900 mb-6">Tools Used</h3>
              <ul class="space-y-3">
                {project.data.tools.map((tool: string) => (
                  <li class="flex items-center text-gray-700">
                    <span class="w-2 h-2 bg-gray-400 rounded-full mr-3"></span>
                    {tool}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )}

    {category === 'food' && project.data.ingredients && (
      <section class="mb-16">
        <div class="max-w-4xl mx-auto">
          <h3 class="text-2xl font-serif font-semibold text-gray-900 mb-6">Ingredients</h3>
          <div class="bg-gray-50 rounded-lg p-6">
            <ul class="space-y-2">
              {project.data.ingredients.map((ingredient: any) => (
                <li class="flex justify-between border-b border-gray-200 pb-2">
                  <span class="font-medium text-gray-900">{ingredient.item}</span>
                  <span class="text-gray-700">{ingredient.amount}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- Tags -->
    {project.data.tags && project.data.tags.length > 0 && (
      <section class="mb-16">
        <div class="max-w-4xl mx-auto">
          <h3 class="text-xl font-semibold text-gray-900 mb-4">Tags</h3>
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag: string) => (
              <span class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Related Projects -->
    {relatedProjects.length > 0 && (
      <section class="mb-16">
        <h2 class="text-3xl font-serif font-semibold text-gray-900 mb-8 text-center">More {categoryInfo.label} Projects</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          {relatedProjects.map((relatedProject) => (
            <a href={`/${category}/${relatedProject.slug}`} class="group">
              <article class="card overflow-hidden hover:shadow-xl transition-all duration-300">
                <div class="aspect-w-16 aspect-h-12 bg-gray-100 overflow-hidden">
                  {relatedProject.data.heroImage ? (
                    <img 
                      src={relatedProject.data.heroImage} 
                      alt={relatedProject.data.title}
                      class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  ) : (
                    <div class="w-full h-48 bg-gradient-to-br from-pale-dogwood/30 to-rose-quartz/30 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                      <span class="text-4xl opacity-60">{categoryInfo.icon}</span>
                    </div>
                  )}
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-serif font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
                    {relatedProject.data.title}
                  </h3>
                  <p class="text-gray-600 text-sm">
                    {relatedProject.data.description}
                  </p>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Commission CTA -->
    <section class="bg-gray-900 rounded-2xl p-12 text-white text-center">
      <h2 class="text-3xl font-serif font-bold mb-4 text-white">Interested in Custom Work?</h2>
      <p class="text-lg mb-8 text-gray-100">
        {category === 'woodworking' && "Let's discuss your custom woodworking project."}
        {category === 'leatherwork' && "Custom leather goods made to your specifications."}
        {category === 'photography' && "Available for portraits, events, and fine art prints."}
        {category === 'costuming' && "Let's create your perfect costume or cosplay."}
        {category === 'food' && "Want a custom recipe or cooking consultation?"}
        {!['woodworking', 'leatherwork', 'photography', 'costuming', 'food'].includes(category) && `Let's discuss your custom ${categoryInfo.label.toLowerCase()} project.`}
      </p>
      <a href="/contact" class="btn-primary">
        Get In Touch
      </a>
    </section>
  </div>
</BaseLayout>