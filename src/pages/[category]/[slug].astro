---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { CATEGORIES, type CategoryKey } from '@/content/config';
import AudioPlayer from '@/components/audio/AudioPlayer';
import GalleryLightbox from '@/components/gallery/GalleryLightbox';
import TabViewer from '@/components/music/TabViewer';
import SheetMusicViewer from '@/components/music/SheetMusicViewer';
import GamePlayer from '@/components/games/GamePlayer';
import ModelViewer from '@/components/3DModelViewer.astro';

export async function getStaticPaths() {
  const paths = [];
  
  // Define valid categories
  const validCategories = Object.keys(CATEGORIES);
  
  // Generate paths for all hobby categories
  for (const category of validCategories) {
    try {
      const collection = await getCollection(category as keyof typeof import('@/content/config').collections);
      
      for (const entry of collection) {
        if (!entry.data.draft && !entry.data.hidden) {
          paths.push({
            params: { 
              category: category,
              slug: entry.slug 
            },
            props: { 
              project: entry,
              category: category,
              categoryInfo: CATEGORIES[category as CategoryKey]
            },
          });
        }
      }
    } catch (error) {
      console.warn(`Could not load collection for ${category}:`, error);
    }
  }
  
  return paths;
}

interface Props {
  project: CollectionEntry<any>;
  category: string;
  categoryInfo: typeof CATEGORIES[CategoryKey];
}

const { project, category, categoryInfo } = Astro.props;

if (!project) {
  return Astro.redirect('/404');
}

// Get other projects from the same category for "more projects" section
let relatedProjects: CollectionEntry<any>[] = [];
try {
  const allProjects = await getCollection(category as keyof typeof import('@/content/config').collections);
  relatedProjects = allProjects
    .filter(p => p.slug !== project.slug && !p.data.draft && !p.data.hidden)
    .slice(0, 2);
} catch (error) {
  console.warn(`Could not load related projects for ${category}:`, error);
}

const { Content } = await project.render();
---

<BaseLayout 
  title={project.data.title}
  description={project.data.description}
>
  <div class="container-custom py-12">
    <!-- Breadcrumb -->
    <nav class="text-sm text-gray-600 dark:text-gray-400 mb-6">
      <a href="/" class="hover:text-gray-900 dark:hover:text-gray-200">Home</a>
      <span class="mx-2">/</span>
      <a href={`/${category}`} class="hover:text-gray-900 dark:hover:text-gray-200 capitalize">{categoryInfo.label}</a>
      <span class="mx-2">/</span>
      <span class="text-gray-900 dark:text-gray-100">{project.data.title}</span>
    </nav>

    <!-- Hero Section -->
    <div class="mb-16">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <!-- Hero Image -->
        <div class="aspect-w-4 aspect-h-3">
          {project.data.heroImage ? (
            <img 
              src={project.data.heroImage} 
              alt={project.data.title}
              class="w-full h-96 object-cover rounded-lg"
            />
          ) : (
            <div class="w-full h-96 bg-gradient-to-br from-pale-dogwood/30 to-rose-quartz/30 rounded-lg flex items-center justify-center">
              <span class="text-6xl opacity-60">{categoryInfo.icon}</span>
            </div>
          )}
        </div>
        
        <!-- Title and Metadata -->
        <div class="lg:pl-8">
          <h1 class="text-4xl lg:text-5xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-4">
            {project.data.title}
          </h1>
          <p class="text-xl text-gray-700 dark:text-gray-300 mb-8">
            {project.data.description}
          </p>
        </div>
      </div>
    </div>

    <!-- Game Player for Games -->
    {category === 'games' && project.slug && (
      <section class="mb-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-8 text-center">Play Game</h2>
          <GamePlayer 
            gameUrl={`/games/extracted/${project.slug}/index.html`}
            title={project.data.title}
            controls={project.data.controls}
            client:load
          />
        </div>
      </section>
    )}

    <!-- Audio Player for Music Projects -->
    {category === 'music' && project.data.audioFile && (
      <section class="mb-16">
        <div class="content-narrow">
          <AudioPlayer 
            src={project.data.audioFile} 
            title={project.data.title}
            artist="Bryant Hayes"
            client:load
          />
        </div>
      </section>
    )}

    <!-- Professional Sheet Music for Music Projects -->
    {category === 'music' && project.data.sheetMusic && (
      <section class="mb-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-8">Sheet Music</h2>
          <SheetMusicViewer 
            musicData={project.data.sheetMusic}
            title={project.data.title}
            format={project.data.sheetMusicFormat || 'alphaTex'}
            client:load
          />
        </div>
      </section>
    )}

    <!-- Guitar Tabs for Music Projects (fallback or additional) -->
    {category === 'music' && project.data.tabs && !project.data.sheetMusic && (
      <section class="mb-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-8">Guitar Tabs</h2>
          <TabViewer 
            tabs={project.data.tabs}
            title={project.data.title}
            tuning={project.data.tuning}
            capo={project.data.capo}
            tempo={project.data.tempo}
            songKey={project.data.key}
            client:load
          />
        </div>
      </section>
    )}

    <!-- 3D Model Viewer (for Woodworking projects with models) -->
    {category === 'woodworking' && project.data.modelUrl && (
      <section class="mb-16">
        <div class="content-narrow">
          <ModelViewer 
            modelUrl={project.data.modelUrl}
            title="Interactive 3D Model"
            height="500px"
          />
        </div>
      </section>
    )}

    <!-- Project Gallery -->
    {category !== 'music' && project.data.gallery && project.data.gallery.length > 0 && (
      <section class="mb-16">
        <div class="content-narrow">
          <h2 class="text-3xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-8">Project Gallery</h2>
          <GalleryLightbox 
            images={project.data.gallery} 
            projectTitle={project.data.title}
            client:load
          />
        </div>
      </section>
    )}

    <!-- Project Content (Markdown) -->
    <section class="mb-16">
      <div class="content-narrow prose prose-lg dark:prose-invert">
        <Content />
      </div>
    </section>

    <!-- Downloads Section -->
    {project.data.downloads && project.data.downloads.length > 0 && (
      <section class="mb-16">
        <div class="content-narrow">
          <h2 class="text-3xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-8">Downloads</h2>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            {project.data.downloads.map((download) => (
              <a 
                href={`/downloads/${category}/${project.slug}/${download.filename}`}
                download={download.filename}
                class="group block p-6 bg-white dark:bg-gray-800 rounded-lg border border-gray-200 dark:border-gray-700 hover:border-gray-300 dark:hover:border-gray-600 hover:shadow-md transition-all duration-200"
              >
                <div class="flex items-start gap-4">
                  <!-- File Type Icon -->
                  <div class="flex-shrink-0 w-12 h-12 bg-gray-100 dark:bg-gray-700 rounded-lg flex items-center justify-center group-hover:bg-gray-200 dark:group-hover:bg-gray-600 transition-colors">
                    {download.fileType === 'pdf' && (
                      <svg class="w-6 h-6 text-red-600 dark:text-red-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" />
                      </svg>
                    )}
                    {download.fileType === 'svg' && (
                      <svg class="w-6 h-6 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M5,3H7V5H5V10A2,2 0 0,1 3,8V6A2,2 0 0,1 5,4V3M19,3V4A2,2 0 0,1 21,6V8A2,2 0 0,1 19,10V5H17V3H19M16,12A2,2 0 0,1 18,10H20A2,2 0 0,1 22,12A2,2 0 0,1 20,14H18A2,2 0 0,1 16,12M20,12V14H18V12H20M15,16H9V18H15A2,2 0 0,1 17,20V22A2,2 0 0,1 15,24H9A2,2 0 0,1 7,22V20A2,2 0 0,1 9,18V16A2,2 0 0,1 11,14H13A2,2 0 0,1 15,16M13,18V20H11V22H13V20H15V18H13Z" />
                      </svg>
                    )}
                    {download.fileType === 'zip' && (
                      <svg class="w-6 h-6 text-purple-600 dark:text-purple-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14,17H16V19H14V17M10,17H12V19H10V17M14,13H16V15H14V13M10,13H12V15H10V13M14,9H16V11H14V9M10,9H12V11H10V9M14,5H16V7H14V5M10,5H12V7H10V5M8,3V5H10V7H8V9H10V11H8V13H10V15H8V17H10V19H8V21H16V19H18V17H16V15H18V13H16V11H18V9H16V7H18V5H16V3H8Z" />
                      </svg>
                    )}
                    {!['pdf', 'svg', 'zip'].includes(download.fileType) && (
                      <svg class="w-6 h-6 text-gray-600 dark:text-gray-400" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M14,2H6A2,2 0 0,0 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2M18,20H6V4H13V9H18V20Z" />
                      </svg>
                    )}
                  </div>
                  
                  <!-- File Details -->
                  <div class="flex-1 min-w-0">
                    <div class="flex items-start justify-between">
                      <div class="flex-1 min-w-0">
                        <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                          {download.title}
                        </h3>
                        {download.description && (
                          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                            {download.description}
                          </p>
                        )}
                        <div class="flex items-center gap-3 mt-2">
                          <span class="text-xs font-medium text-gray-500 dark:text-gray-500 uppercase tracking-wider">
                            {download.fileType}
                          </span>
                          {download.fileSize && (
                            <span class="text-xs text-gray-500 dark:text-gray-500">
                              {download.fileSize}
                            </span>
                          )}
                          {download.category && (
                            <span class="px-2 py-1 bg-gray-100 dark:bg-gray-700 text-xs text-gray-700 dark:text-gray-300 rounded-full capitalize">
                              {download.category}
                            </span>
                          )}
                        </div>
                      </div>
                      <!-- Download Arrow -->
                      <svg class="w-5 h-5 text-gray-400 dark:text-gray-500 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors flex-shrink-0 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      </svg>
                    </div>
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Games-specific details section -->
    {category === 'games' && (
      <section class="mb-16">
        <div class="content-narrow">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div>
              <h3 class="text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-6">Game Details</h3>
              <dl class="space-y-4">
                {project.data.gameEngine && (
                  <div class="flex">
                    <dt class="font-medium text-gray-700 dark:text-gray-300 w-24">Engine:</dt>
                    <dd class="text-gray-900 dark:text-gray-100">{project.data.gameEngine}</dd>
                  </div>
                )}
                {project.data.platforms && project.data.platforms.length > 0 && (
                  <div class="flex">
                    <dt class="font-medium text-gray-700 dark:text-gray-300 w-24">Platforms:</dt>
                    <dd class="text-gray-900 dark:text-gray-100">
                      {project.data.platforms.map((platform: string, index: number) => (
                        <span>
                          {platform.charAt(0).toUpperCase() + platform.slice(1)}
                          {index < project.data.platforms.length - 1 ? ', ' : ''}
                        </span>
                      ))}
                    </dd>
                  </div>
                )}
                {project.data.developmentTime && (
                  <div class="flex">
                    <dt class="font-medium text-gray-700 dark:text-gray-300 w-24">Dev Time:</dt>
                    <dd class="text-gray-900 dark:text-gray-100">{project.data.developmentTime}</dd>
                  </div>
                )}
                {project.data.itchUrl && (
                  <div class="flex">
                    <dt class="font-medium text-gray-700 dark:text-gray-300 w-24">Itch.io:</dt>
                    <dd>
                      <a 
                        href={project.data.itchUrl} 
                        target="_blank" 
                        rel="noopener noreferrer"
                        class="text-blue-600 dark:text-blue-400 hover:underline"
                      >
                        View on Itch.io
                      </a>
                    </dd>
                  </div>
                )}
              </dl>
            </div>
            <div>
              {project.data.contributors && project.data.contributors.length > 0 && (
                <>
                  <h3 class="text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-6">Contributors</h3>
                  <div class="space-y-3">
                    {project.data.contributors.map((contributor: any) => (
                      <div class="flex items-center justify-between">
                        <div>
                          <div class="font-medium text-gray-900 dark:text-gray-100">
                            {contributor.url ? (
                              <a 
                                href={contributor.url} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="text-blue-600 dark:text-blue-400 hover:underline"
                              >
                                {contributor.name}
                              </a>
                            ) : (
                              contributor.name
                            )}
                          </div>
                          <div class="text-sm text-gray-600 dark:text-gray-400">{contributor.role}</div>
                        </div>
                      </div>
                    ))}
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </section>
    )}

    <!-- Category-specific details sections -->
    {category === 'woodworking' && project.data.materials && (
      <section class="mb-16">
        <div class="content-narrow">
          <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
            <div>
              <h3 class="text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-6">Materials Used</h3>
              <ul class="space-y-3">
                {project.data.materials.map((material: string) => (
                  <li class="flex items-center text-gray-700 dark:text-gray-300">
                    <span class="w-2 h-2 bg-gray-400 dark:bg-gray-500 rounded-full mr-3"></span>
                    {material}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <h3 class="text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-6">Tools Used</h3>
              <ul class="space-y-3">
                {project.data.tools.map((tool: string) => (
                  <li class="flex items-center text-gray-700 dark:text-gray-300">
                    <span class="w-2 h-2 bg-gray-400 dark:bg-gray-500 rounded-full mr-3"></span>
                    {tool}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>
    )}

    {category === 'food' && project.data.ingredients && (
      <section class="mb-16">
        <div class="content-narrow">
          <h3 class="text-2xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-6">Ingredients</h3>
          <div class="bg-gray-50 dark:bg-gray-800 rounded-lg p-6">
            <ul class="space-y-2">
              {project.data.ingredients.map((ingredient: any) => (
                <li class="flex justify-between border-b border-gray-200 dark:border-gray-600 pb-2">
                  <span class="font-medium text-gray-900 dark:text-gray-100">{ingredient.item}</span>
                  <span class="text-gray-700 dark:text-gray-300">{ingredient.amount}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    )}

    <!-- Tags -->
    {project.data.tags && project.data.tags.length > 0 && (
      <section class="mb-16">
        <div class="content-narrow">
          <h3 class="text-xl font-semibold text-gray-900 dark:text-gray-100 mb-4">Tags</h3>
          <div class="flex flex-wrap gap-2">
            {project.data.tags.map((tag: string) => (
              <span class="px-3 py-1 bg-gray-100 dark:bg-gray-700 text-gray-700 dark:text-gray-300 rounded-full text-sm">
                {tag}
              </span>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Related Projects -->
    {relatedProjects.length > 0 && (
      <section class="mb-16">
        <h2 class="text-3xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-8 text-center">More {categoryInfo.label} Projects</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 content-narrow">
          {relatedProjects.map((relatedProject) => (
            <a href={`/${category}/${relatedProject.slug}`} class="group">
              <article class="card overflow-hidden hover:shadow-xl transition-all duration-300">
                <div class="aspect-w-16 aspect-h-12 bg-gray-100 overflow-hidden">
                  {relatedProject.data.heroImage ? (
                    <img 
                      src={relatedProject.data.heroImage} 
                      alt={relatedProject.data.title}
                      class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                    />
                  ) : (
                    <div class="w-full h-48 bg-gradient-to-br from-pale-dogwood/30 to-rose-quartz/30 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                      <span class="text-4xl opacity-60">{categoryInfo.icon}</span>
                    </div>
                  )}
                </div>
                <div class="p-6">
                  <h3 class="text-xl font-serif font-semibold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors">
                    {relatedProject.data.title}
                  </h3>
                  <p class="text-gray-600 dark:text-gray-400 text-sm">
                    {relatedProject.data.description}
                  </p>
                </div>
              </article>
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- Commission CTA -->
    <section class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-600 rounded-lg p-6 text-center">
      <h2 class="text-xl font-serif font-semibold mb-3 text-gray-900 dark:text-gray-100">Interested in Custom Work?</h2>
      <p class="text-base mb-6 text-gray-600 dark:text-gray-400">
        {category === 'woodworking' && "Let's discuss your custom woodworking project."}
        {category === 'leatherwork' && "Custom leather goods made to your specifications."}
        {category === 'photography' && "Available for portraits, events, and fine art prints."}
        {category === 'costuming' && "Let's create your perfect costume or cosplay."}
        {category === 'food' && "Want a custom recipe or cooking consultation?"}
        {category === 'games' && "Interested in custom game development or prototypes?"}
        {!['woodworking', 'leatherwork', 'photography', 'costuming', 'food', 'games'].includes(category) && `Let's discuss your custom ${categoryInfo.label.toLowerCase()} project.`}
      </p>
      <a href="/contact" class="btn-primary text-sm px-6 py-2">
        Get In Touch
      </a>
    </section>
  </div>
</BaseLayout>