---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Golf" 
  description="Course reviews and improvement journey"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Golf
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Course reviews, swing analysis, equipment insights, and the ongoing journey 
        to improve my game. Golf teaches patience, precision, and humility.
      </p>
    </div>

    <div class="text-center">
      <div class="w-32 h-32 mx-auto mb-8 rounded-full bg-gray-100 flex items-center justify-center">
        <span class="text-6xl opacity-60">⛳</span>
      </div>
      <p class="text-gray-600 mb-8">
        Course reviews, practice notes, and improvement tracking coming soon.
      </p>
      <a href="/contact" class="btn-primary">
        Golf Discussions Welcome
      </a>
    </div>
  </div>
</BaseLayout>