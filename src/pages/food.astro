---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectTile from '@/components/projects/ProjectTile.astro';

// Get all food projects from content collections
const allProjects = await getCollection('food', ({ data }) => !data.draft);
---

<BaseLayout 
  title="Food" 
  description="Recipes, BBQ techniques, and culinary experiments"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Food
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Exploring flavors through BBQ, home cooking, and recipe development. 
        From low-and-slow brisket to experimental dishes and time-tested favorites.
      </p>
    </div>

    {allProjects.length > 0 ? (
      <!-- Projects Grid -->
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {allProjects.map((project) => (
            <ProjectTile project={project} category="food" />
          ))}
        </div>
      </section>
    ) : (
      <div class="text-center">
        <div class="w-32 h-32 mx-auto mb-8 rounded-full bg-gray-100 flex items-center justify-center">
          <span class="text-6xl opacity-60">🍖</span>
        </div>
        <p class="text-gray-600 mb-8">
          Recipe collection and cooking documentation coming soon.
        </p>
        <a href="/contact" class="btn-primary">
          Share a Recipe
        </a>
      </div>
    )}

    <!-- Commission -->
    <section class="bg-gray-900 rounded-2xl p-12 text-white text-center">
      <h2 class="text-3xl font-serif font-bold mb-4 text-white">Want to Share a Recipe?</h2>
      <p class="text-lg mb-8 text-gray-100">
        Got a great recipe or cooking technique to share?
      </p>
      <a href="/contact" class="btn-primary">
        Get In Touch
      </a>
    </section>
  </div>
</BaseLayout>