---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectTile from '@/components/projects/ProjectTile.astro';
import WorkInProgress from '@/components/projects/WorkInProgress.astro';

// Get all food projects from content collections
const allProjects = await getCollection('food', ({ data }) => !data.draft && !data.hidden);
---

<BaseLayout 
  title="Food" 
  description="Recipes, BBQ techniques, and culinary experiments"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Food
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Exploring flavors through BBQ, home cooking, and recipe development. 
        From low-and-slow brisket to experimental dishes and time-tested favorites.
      </p>
    </div>

    {allProjects.length > 0 ? (
      <!-- Projects Grid -->
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {allProjects.map((project) => (
            <ProjectTile project={project} category="food" />
          ))}
        </div>
      </section>
    ) : (
      <section class="mb-16">
        <WorkInProgress category="food" />
      </section>
    )}

    <!-- Commission -->
    <section class="bg-gray-50 border border-gray-200 rounded-lg p-6 text-center">
      <h2 class="text-xl font-serif font-semibold mb-3 text-gray-900">Want to Share a Recipe?</h2>
      <p class="text-base mb-6 text-gray-600">
        Got a great recipe or cooking technique to share?
      </p>
      <a href="/contact" class="btn-primary text-sm px-6 py-2">
        Get In Touch
      </a>
    </section>
  </div>
</BaseLayout>