---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectTile from '@/components/projects/ProjectTile.astro';

// Get all photography projects from content collections
const allProjects = await getCollection('photography', ({ data }) => !data.draft);

const equipment = [
  { category: 'Camera Body', items: ['Canon EOS R5', 'Canon EOS R6 Mark II'] },
  { category: 'Lenses', items: ['24-70mm f/2.8L', '70-200mm f/2.8L', '16-35mm f/2.8L', '85mm f/1.4L'] },
  { category: 'Accessories', items: ['Carbon Fiber Tripod', 'ND Filters', 'Polarizing Filter', 'Remote Shutter'] },
  { category: 'Software', items: ['Adobe Lightroom', 'Adobe Photoshop', 'Capture One'] }
];

---

<BaseLayout 
  title="Photography" 
  description="Explore Bryant Hayes' photography portfolio featuring landscapes, portraits, and street photography"
>
  <div class="container-custom py-12">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Photography
      </h1>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Capturing moments, emotions, and the beauty of our world through the lens. 
        From sweeping landscapes to intimate portraits, each image tells a story.
      </p>
    </div>

    <!-- Photo Projects -->
    {allProjects.length > 0 ? (
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {allProjects.map((project) => (
            <ProjectTile project={project} category="photography" />
          ))}
        </div>
      </section>
    ) : (
      <section class="mb-16 text-center">
        <div class="w-32 h-32 mx-auto mb-8 rounded-full bg-gray-100 flex items-center justify-center">
          <span class="text-6xl opacity-60">📷</span>
        </div>
        <p class="text-gray-600 mb-8">
          Photography portfolio coming soon.
        </p>
      </section>
    )}

    <!-- Equipment Section -->
    <section class="mb-16">
      <h2 class="text-3xl font-serif font-semibold text-gray-900 mb-8 text-center">Equipment</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
        {equipment.map((category) => (
          <div class="card p-6">
            <h3 class="font-semibold text-gray-900 mb-4">{category.category}</h3>
            <ul class="space-y-2">
              {category.items.map((item) => (
                <li class="text-sm text-gray-600 flex items-center">
                  <span class="w-2 h-2 bg-pale-dogwood rounded-full mr-3"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>


    <!-- Commission -->
    <section class="bg-gray-50 border border-gray-200 rounded-lg p-6 text-center">
      <h2 class="text-xl font-serif font-semibold mb-3 text-gray-900">Interested in Custom Work?</h2>
      <p class="text-base mb-6 text-gray-600">
        Available for portraits, events, and fine art prints.
      </p>
      <a href="/contact" class="btn-primary text-sm px-6 py-2">
        Get In Touch
      </a>
    </section>
  </div>
</BaseLayout>