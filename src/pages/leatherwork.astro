---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectTile from '@/components/projects/ProjectTile.astro';
import WorkInProgress from '@/components/projects/WorkInProgress.astro';

// Get all leatherwork projects from content collections
const allProjects = await getCollection('leatherwork', ({ data }) => !data.draft && !data.hidden);
---

<BaseLayout 
  title="Leatherwork" 
  description="Handcrafted leather goods with attention to detail and durability"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Leatherwork
      </h1>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Handcrafting durable leather goods with premium materials and traditional techniques. 
        Each piece is built to last and improve with age.
      </p>
    </div>

    {allProjects.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
        {allProjects.map((project) => (
          <ProjectTile project={project} category="leatherwork" />
        ))}
      </div>
    ) : (
      <div class="mb-16">
        <WorkInProgress category="leatherwork" />
      </div>
    )}

    <!-- Commission -->
    <section class="bg-gray-50 border border-gray-200 rounded-lg p-6 text-center">
      <h2 class="text-xl font-serif font-semibold mb-3 text-gray-900">Interested in Custom Work?</h2>
      <p class="text-base mb-6 text-gray-600">
        Custom leather goods made to your specifications.
      </p>
      <a href="/contact" class="btn-primary text-sm px-6 py-2">
        Get In Touch
      </a>
    </section>
  </div>
</BaseLayout>