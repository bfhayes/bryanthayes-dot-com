---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import { getPageContent, getSiteConfig } from '../lib/content';

const pageData = await getPageContent('about');
const siteData = await getSiteConfig();

const { Content } = await pageData.render();

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'About' }
];
---

<Base 
  title={pageData.data.title}
  description={pageData.data.description}
>
  <Section container={false} background="subtle" padding="small">
    <div class="container">
      <PageHeader 
        title="About Hailey"
        subtitle="Licensed Marriage and Family Therapist dedicated to compassionate, evidence-based care"
        breadcrumb={breadcrumb}
      />
    </div>
  </Section>

  <Section>
    <div class="grid lg:grid-cols-3 gap-12">
      <!-- Main Content -->
      <div class="lg:col-span-2">
        <div class="prose prose-lg max-w-none">
          <Content />
        </div>
      </div>

      <!-- Sidebar -->
      <div class="space-y-8">
        <!-- Professional Photo -->
        <Card hover>
          <div class="text-center">
            <img
              src="/images/headshot.jpg"
              alt="Hailey Gonnerman, LMFT"
              class="w-full max-w-sm mx-auto rounded-xl mb-4"
              width="300"
              height="400"
            />
            <h3 class="text-xl font-semibold text-neutral-900 mb-2">
              {siteData.name}, {siteData.credentials}
            </h3>
            <p class="text-neutral-600">{siteData.tagline}</p>
          </div>
        </Card>

        <!-- Quick Facts -->
        <Card hover>
          <h3 class="text-lg font-semibold text-neutral-900 mb-4">
            Professional Information
          </h3>
          <div class="space-y-3 text-sm">
            <div>
              <span class="font-medium text-neutral-700">License:</span>
              <span class="text-neutral-600 ml-2">{siteData.license}</span>
            </div>
            <div>
              <span class="font-medium text-neutral-700">Education:</span>
              <span class="text-neutral-600 ml-2">M.A., Marriage and Family Therapy, San Jose State University</span>
            </div>
            <div>
              <span class="font-medium text-neutral-700">Specializations:</span>
              <div class="text-neutral-600 ml-2 mt-1 space-y-1">
                <p>• Anxiety & Relationship Stress</p>
                <p>• Life Transitions & Trauma</p>
                <p>• Family & Couples Therapy</p>
                <p>• Teen & Preteen Support</p>
              </div>
            </div>
            <div>
              <span class="font-medium text-neutral-700">Affiliations:</span>
              <span class="text-neutral-600 ml-2">Oregon Association for Marriage and Family Therapy (OAMFT)</span>
            </div>
          </div>
        </Card>

        <!-- Therapeutic Approaches -->
        <Card hover>
          <h3 class="text-lg font-semibold text-neutral-900 mb-4">
            Therapeutic Approaches
          </h3>
          <div class="space-y-3">
            {[
              'Cognitive Behavioral Therapy (CBT)',
              'Acceptance and Commitment Therapy (ACT)',
              'Emotionally Focused Therapy (EFT)',
              'Trauma-Focused Approaches',
              'Mindfulness-Based Interventions',
              'Family Systems Therapy'
            ].map((approach) => (
              <div class="flex items-start gap-3">
                <div class="w-2 h-2 bg-brand-500 rounded-full mt-2 flex-shrink-0"></div>
                <span class="text-sm text-neutral-600">{approach}</span>
              </div>
            ))}
          </div>
        </Card>

        <!-- Contact CTA -->
        <Card background="subtle" hover>
          <div class="text-center">
            <h3 class="text-lg font-semibold text-neutral-900 mb-3">
              Ready to Connect?
            </h3>
            <p class="text-sm text-neutral-600 mb-4">
              Schedule a free 15-minute consultation to see if we're a good fit.
            </p>
            <Button href="/contact" fullWidth>
              Get Started
            </Button>
          </div>
        </Card>
      </div>
    </div>
  </Section>

  <!-- Additional Info Section -->
  <Section background="accent">
    <div class="grid md:grid-cols-2 gap-12">
      <div>
        <h2 class="text-2xl font-bold text-neutral-900 mb-6">
          My Commitment to You
        </h2>
        <div class="space-y-4 text-neutral-700">
          <p>
            I'm committed to providing a safe, supportive environment where you can explore your 
            experiences without judgment. Your healing journey is unique, and I honor the courage 
            it takes to seek support.
          </p>
          <p>
            I stay current with the latest research and best practices through regular continuing 
            education and professional development. This ensures you receive the most effective, 
            evidence-based care available.
          </p>
        </div>
      </div>

      <div>
        <h2 class="text-2xl font-bold text-neutral-900 mb-6">
          Beyond the Office
        </h2>
        <div class="space-y-4 text-neutral-700">
          <p>
            When I'm not in session with clients, you might find me hiking the beautiful trails 
            around Oregon, practicing yoga, or experimenting with new recipes in the kitchen. 
            I believe in the importance of work-life balance and model the self-care practices I 
            encourage in my clients.
          </p>
          <p>
            I'm passionate about mental health advocacy and believe that therapy should be accessible 
            to everyone who needs it.
          </p>
        </div>
      </div>
    </div>
  </Section>

  <!-- CTA Section -->
  <Section>
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl font-bold text-neutral-900 mb-6">
        Let's Work Together
      </h2>
      <p class="text-lg text-neutral-600 mb-8">
        I'm honored to be part of your journey toward greater well-being and look forward 
        to the possibility of working together.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/contact" variant="primary">
          Schedule Consultation
        </Button>
        <Button href="/services" variant="outline">
          View Services
        </Button>
      </div>
    </div>
  </Section>
</Base>