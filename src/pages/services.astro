---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import { getPageContent, getSpecialties } from '../lib/content';

const pageData = await getPageContent('services');
const specialties = await getSpecialties();

const { Content } = await pageData.render();

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'Services' }
];

const serviceDetails = [
  {
    title: 'Individual Therapy',
    duration: '50 minutes',
    fee: '$160',
    description: 'One-on-one sessions focused on your personal growth and healing journey.',
    features: ['Personalized treatment approach', 'Evidence-based techniques', 'Safe, confidential space']
  }
];
---

<Base 
  title={pageData.data.title}
  description={pageData.data.description}
>
  <Section container={false} background="subtle" padding="small">
    <div class="container">
      <PageHeader 
        title="Therapy Services"
        subtitle="Compassionate, evidence-based therapy tailored to your unique needs and goals"
        breadcrumb={breadcrumb}
      />
    </div>
  </Section>

  <!-- Services Overview -->
  <Section>
    <div class="max-w-4xl mx-auto">
      <div class="prose prose-lg max-w-none mb-12">
        <Content />
      </div>
    </div>
  </Section>

  <!-- Service Types -->
  <Section background="accent">
    <h2 class="text-3xl font-bold text-neutral-900 mb-8 text-center">
      Service Details
    </h2>
    
    <div class="max-w-4xl mx-auto">
      {serviceDetails.map((service) => (
        <Card class="mb-8">
          <div class="grid md:grid-cols-3 gap-6">
            <div class="md:col-span-2">
              <h3 class="text-2xl font-semibold text-neutral-900 mb-3">
                {service.title}
              </h3>
              <p class="text-neutral-600 mb-4">{service.description}</p>
              
              <ul class="space-y-2">
                {service.features.map((feature) => (
                  <li class="flex items-center gap-2">
                    <div class="w-2 h-2 bg-brand-500 rounded-full flex-shrink-0"></div>
                    <span class="text-sm text-neutral-600">{feature}</span>
                  </li>
                ))}
              </ul>
            </div>
            
            <div class="text-center md:text-right">
              <div class="inline-block bg-brand-bg rounded-lg p-4">
                <p class="text-sm text-neutral-600 mb-1">Session Length</p>
                <p class="text-xl font-semibold text-neutral-900 mb-3">{service.duration}</p>
                <p class="text-sm text-neutral-600 mb-1">Fee</p>
                <p class="text-2xl font-bold text-brand-700">{service.fee}</p>
                <p class="text-xs text-neutral-500 mt-1">per session</p>
              </div>
            </div>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Specialization Areas -->
  <Section>
    <h2 class="text-3xl font-bold text-neutral-900 mb-8 text-center">
      Specialization Areas
    </h2>
    
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {specialties.map((specialty) => (
        <Card hover class="h-full">
          <div class="mb-4">
            <div class="w-12 h-12 bg-brand-bg rounded-full flex items-center justify-center mb-3">
              <div class="w-6 h-6 bg-brand-500 rounded-full"></div>
            </div>
            <h3 class="font-semibold text-neutral-900 mb-2">{specialty.title}</h3>
            <p class="text-sm text-neutral-600 leading-relaxed">{specialty.description}</p>
          </div>
        </Card>
      ))}
    </div>
  </Section>

  <!-- Payment & Insurance -->
  <Section background="subtle">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-neutral-900 mb-8 text-center">
        Payment & Insurance
      </h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        <Card>
          <h3 class="text-xl font-semibold text-neutral-900 mb-4">
            Insurance & Payment
          </h3>
          <div class="space-y-4 text-neutral-700">
            <p>
              I am an out-of-network provider for all insurance plans. I can provide you with 
              a superbill (detailed receipt) that you can submit to your insurance company for 
              potential reimbursement, depending on your out-of-network benefits.
            </p>
            <p>
              Payment is due at the time of service and can be made by cash, check, or credit card.
            </p>
            <div class="pt-4 border-t border-neutral-200">
              <p class="font-medium text-neutral-900 mb-2">Accepted Payment Methods:</p>
              <ul class="space-y-1 text-sm">
                <li>• Cash</li>
                <li>• Check</li>
                <li>• Credit Card (Visa, MasterCard, Discover)</li>
              </ul>
            </div>
          </div>
        </Card>

        <Card>
          <h3 class="text-xl font-semibold text-neutral-900 mb-4">
            Sliding Scale
          </h3>
          <div class="space-y-4 text-neutral-700">
            <p>
              I believe that everyone deserves access to quality mental health care. I offer 
              a limited number of sliding scale spots for clients experiencing financial hardship.
            </p>
            <p>
              Please contact me to discuss your situation and available options. I'm committed 
              to working with you to find a solution that makes therapy accessible.
            </p>
            <div class="pt-4">
              <Button href="/contact" variant="outline" size="sm">
                Discuss Sliding Scale Options
              </Button>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </Section>

  <!-- Therapeutic Approaches -->
  <Section>
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl font-bold text-neutral-900 mb-8 text-center">
        Therapeutic Approaches
      </h2>
      
      <div class="grid md:grid-cols-2 gap-8">
        {[
          {
            title: 'Cognitive Behavioral Therapy (CBT)',
            description: 'Identifying and changing unhelpful thought patterns and behaviors that contribute to emotional distress.'
          },
          {
            title: 'Acceptance and Commitment Therapy (ACT)',
            description: 'Building psychological flexibility and helping you live according to your values while accepting difficult experiences.'
          },
          {
            title: 'Emotion-Focused Therapy',
            description: 'Understanding and working with emotions as a pathway to healing and positive change.'
          },
          {
            title: 'Mindfulness-Based Approaches',
            description: 'Cultivating present-moment awareness and acceptance to reduce stress and increase well-being.'
          },
          {
            title: 'Trauma-Informed Care',
            description: 'Recognizing the impact of trauma and promoting safety, trustworthiness, and empowerment in therapy.'
          },
          {
            title: 'Integrative Approach',
            description: 'Combining multiple therapeutic modalities to create a personalized treatment plan that best serves your needs.'
          }
        ].map((approach) => (
          <Card>
            <h3 class="font-semibold text-neutral-900 mb-2">{approach.title}</h3>
            <p class="text-sm text-neutral-600">{approach.description}</p>
          </Card>
        ))}
      </div>
    </div>
  </Section>

  <!-- Getting Started -->
  <Section background="accent">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold text-neutral-900 mb-6">
        Getting Started
      </h2>
      
      <div class="grid md:grid-cols-3 gap-8 mb-8">
        {[
          {
            step: '1',
            title: 'Initial Contact',
            description: 'Call or email to express interest in therapy'
          },
          {
            step: '2',
            title: 'Brief Consultation',
            description: 'Free 15-minute phone conversation to discuss your needs'
          },
          {
            step: '3',
            title: 'First Session',
            description: 'Schedule your first 50-minute therapy session'
          }
        ].map((step) => (
          <div class="text-center">
            <div class="w-12 h-12 bg-brand-700 text-white rounded-full flex items-center justify-center mx-auto mb-3 text-xl font-bold">
              {step.step}
            </div>
            <h3 class="font-semibold text-neutral-900 mb-2">{step.title}</h3>
            <p class="text-sm text-neutral-600">{step.description}</p>
          </div>
        ))}
      </div>

      <p class="text-lg text-neutral-600 mb-8">
        I understand that reaching out for therapy can feel vulnerable, and I'm honored that 
        you're considering me as part of your support system.
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href="/contact" variant="primary">
          Schedule Free Consultation
        </Button>
        <Button href="/about" variant="outline">
          Learn More About Me
        </Button>
      </div>
    </div>
  </Section>
</Base>