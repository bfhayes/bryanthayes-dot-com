---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResumeViewer from '@/components/professional/ResumeViewer';

// Work/Resume data - in production this would come from content collections
const resumeData = {
  name: 'Bryant Hayes',
  title: 'Senior Security Software Engineer',
  location: 'Santa Clara, CA',
  phone: '503-551-8418',
  email: 'bryant.hayes@icloud.com',
  linkedin: 'www.linkedin.com/in/bryantfhayes/',
  github: 'github.com/bfhayes',
  summary: 'Seasoned security engineer (8 yrs) specializing in high-performance DRM and embedded Linux. Led cross-functional teams that shipped secure media services used by hundreds of millions of devices with zero critical incidents across two iOS releases.',
  
  experience: [
    {
      company: 'Apple Inc.',
      position: 'Senior Security Software Engineer',
      startDate: 'Dec 2020',
      endDate: 'Present',
      location: 'Cupertino, CA',
      highlights: [
        'Designed DRM security architecture for Apple Services, protecting billions of streams across iOS, tvOS & macOS',
        'Implemented cryptographic protocols in C++/Swift; integrated Secure Enclave & TrustZone keys',
        'Re-wrote token-validation micro-service, cutting latency 45% and sustaining 50k req/s',
        'Mentored six engineers; instituted threat modeling and fuzzing that kept P1 security incidents at 0'
      ],
      technologies: ['C/C++17', 'Swift', 'DRM', 'Cryptography', 'Secure Enclave', 'TrustZone']
    },
    {
      company: 'Cognex Corp.',
      position: 'Senior Software Engineer',
      startDate: 'Feb 2019',
      endDate: 'Nov 2020',
      location: 'Portland, OR',
      highlights: [
        'Produced Yocto Linux images and enabled Secure Boot for ARM vision systems',
        'Containerized toolchains, reducing build times 60%; managed CI with TeamCity + Docker'
      ],
      technologies: ['Yocto', 'Linux', 'Secure Boot', 'ARM', 'Docker', 'TeamCity']
    },
    {
      company: 'Cognex Corp.',
      position: 'Staff Software Engineer',
      startDate: 'Feb 2017',
      endDate: 'Jan 2019',
      location: 'Portland, OR',
      highlights: [
        'Scrum-mastered platform team; validated new ARM hardware with custom diagnostics',
        'Championed culture, earning "Minister of Culture" recognition'
      ],
      technologies: ['ARM', 'Embedded Linux', 'Hardware Validation', 'Scrum']
    },
    {
      company: 'Cognex Corp.',
      position: 'Associate Software Engineer',
      startDate: 'Jul 2016',
      endDate: 'Jan 2017',
      location: 'Portland, OR',
      highlights: [
        'Developed autofocus firmware and optimized discrete-I/O drivers on embedded Linux'
      ],
      technologies: ['Embedded Linux', 'Firmware', 'C/C++']
    }
  ],
  
  education: [
    {
      institution: 'Oregon State University',
      degree: 'B.S. Electrical & Computer Engineering',
      year: '2011 – 2016',
      location: 'Corvallis, OR',
      honors: 'Dean\'s List · IEEE Chapter President'
    }
  ],
  
  skills: {
    'Security': ['DRM', 'Cryptography', 'Secure Boot', 'TrustZone', 'SEP'],
    'Languages': ['C/C++17', 'Swift', 'Python'],
    'Frameworks': ['FastAPI', 'React', 'Docker', 'Yocto'],
    'Tools': ['Git', 'TeamCity', 'Redis']
  }
};
---

<BaseLayout 
  title="Work" 
  description="Bryant Hayes - Professional Work & Experience"
>
  <div class="container-custom py-12">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8">
      <div>
        <h1 class="text-4xl font-serif font-bold text-gray-900 mb-2">Work</h1>
        <p class="text-gray-600">Professional experience, skills, and projects</p>
      </div>
      <div class="flex gap-3 mt-4 md:mt-0">
        <a 
          href="/resume/Bryant_Hayes_Resume.pdf" 
          download
          class="btn-primary no-print"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download PDF
        </a>
        <button 
          onclick="window.print()"
          class="btn-ghost no-print"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Print
        </button>
      </div>
    </div>

    <!-- Resume Content -->
    <div class="bg-white rounded-lg shadow-lg p-8 md:p-12">
      <ResumeViewer client:load resumeData={resumeData} />
    </div>

  </div>
</BaseLayout>