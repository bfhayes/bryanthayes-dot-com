---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResumeViewer from '@/components/professional/ResumeViewer';

// Work/Resume data - in production this would come from content collections
const resumeData = {
  name: 'Bryant Hayes',
  title: 'Senior Security Software Engineer',
  location: 'Santa Clara, CA',
  phone: '503-551-8418',
  email: 'bryant.hayes@icloud.com',
  linkedin: 'www.linkedin.com/in/bryantfhayes/',
  github: 'github.com/bfhayes',
  summary: 'Seasoned security engineer specializing in high-performance DRM and embedded Linux. Led cross-functional teams that shipped secure media services used by hundreds of millions of devices with zero critical incidents across two iOS releases.',
  
  experience: [
    {
      company: 'Apple Inc.',
      position: 'Senior Security Software Engineer',
      startDate: 'Dec 2020',
      endDate: 'Present',
      location: 'Cupertino, CA',
      highlights: [
        'Architected enterprise-scale security infrastructure serving 1+ billion devices, implementing intelligent pre-loading mechanisms that eliminated server load spikes and improved system reliability',
        'Led end-to-end development of critical identity management framework from conception to production, securing cross-functional approval from 5+ teams and enabling seamless platform integrations',
        'Designed reusable software frameworks adopted across multiple engineering teams, reducing code duplication by 40% through modular components for cryptography and inter-process communication',
        'Delivered production-critical daemon functionality and client libraries, implementing secure license validation and application launch controls with microsecond-level performance'
      ],
      technologies: ['C/C++17', 'Swift', 'DRM', 'Cryptography', 'Secure Enclave', 'TrustZone']
    },
    {
      company: 'Cognex Corp.',
      position: 'Senior Software Engineer',
      startDate: 'Feb 2019',
      endDate: 'Nov 2020',
      location: 'Portland, OR',
      highlights: [
        'Led creation of embedded Linux distribution build system using Yocto Project to produce software images for custom hardware, enabling multiple engineering teams to perform distributed builds',
        'Architected secure boot infrastructure for ARM vision systems with TrustZone technology, implementing system-level security design and deployment'
      ],
      technologies: ['Yocto', 'Linux', 'Secure Boot', 'ARM', 'TrustZone', 'Docker', 'TeamCity']
    },
    {
      company: 'Cognex Corp.',
      position: 'Staff Software Engineer',
      startDate: 'Feb 2017',
      endDate: 'Jan 2019',
      location: 'Portland, OR',
      highlights: [
        'Led platform architecture team as Scrum Master, developing diagnostic firmware to validate custom ARM SoC hardware and support debugging of complex system software',
        'Spearheaded cross-functional culture initiatives as elected "Minister of Culture," planning activities for multiple teams and promoting Cognex\'s "Work Hard, Play Hard, Move Fast" values'
      ],
      technologies: ['ARM', 'Embedded Linux', 'Hardware Validation', 'Scrum', 'SoC']
    },
    {
      company: 'Cognex Corp.',
      position: 'Associate Software Engineer',
      startDate: 'Jul 2016',
      endDate: 'Jan 2017',
      location: 'Portland, OR',
      highlights: [
        'Designed proprietary autofocus algorithm significantly decreasing focus time on embedded camera systems, creating Python simulation software for algorithm prototyping',
        'Optimized low-level system performance by analyzing and improving discrete I/O drivers for embedded Linux systems'
      ],
      technologies: ['Embedded Linux', 'Firmware', 'C/C++', 'Python', 'Algorithm Design']
    }
  ],
  
  education: [
    {
      institution: 'Oregon State University',
      degree: 'B.S. Electrical & Computer Engineering',
      year: '2011 – 2016',
      location: 'Corvallis, OR',
      honors: 'Dean\'s List · IEEE Chapter President'
    }
  ],
  
  skills: {
    'Security': ['DRM', 'Cryptography', 'Secure Boot', 'TrustZone', 'SEP'],
    'Languages': ['C/C++17', 'Swift', 'Python'],
    'Frameworks': ['FastAPI', 'React', 'Docker', 'Yocto'],
    'Tools': ['Git', 'TeamCity', 'Redis']
  }
};
---

<BaseLayout 
  title="Work" 
  description="Bryant Hayes - Professional Work & Experience"
>
  <div class="container-custom py-12">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8">
      <div>
        <h1 class="text-4xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-2">Work</h1>
        <p class="text-gray-600 dark:text-gray-400">Professional experience, skills, and projects</p>
      </div>
      <div class="flex gap-3 mt-4 md:mt-0">
        <a 
          href="/resume/Bryant_Hayes_Resume.pdf" 
          download
          class="btn-primary no-print"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download PDF
        </a>
        <button 
          onclick="window.print()"
          class="btn-ghost no-print"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Print
        </button>
      </div>
    </div>

    <!-- Resume Content -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg dark:shadow-gray-900/50 p-8 md:p-12">
      <ResumeViewer client:load resumeData={resumeData} />
    </div>

  </div>
</BaseLayout>