---
import BaseLayout from '@/layouts/BaseLayout.astro';
import ResumeViewer from '@/components/professional/ResumeViewer';

// Read resume data from JSON file (single source of truth)
import resumeJson from '@/data/resume.json';

// Transform JSON structure to match ResumeViewer component expectations
const resumeData = {
  name: resumeJson.personal.name,
  title: resumeJson.personal.title,
  location: resumeJson.personal.location,
  phone: resumeJson.personal.phone,
  email: resumeJson.personal.email,
  linkedin: `www.linkedin.com/in/${resumeJson.personal.linkedin}/`,
  github: `github.com/${resumeJson.personal.github}`,
  summary: resumeJson.summary,
  experience: resumeJson.experience,
  education: resumeJson.education,
  skills: resumeJson.skills
};
---

<BaseLayout 
  title="Work" 
  description="Bryant Hayes - Professional Work & Experience"
>
  <div class="container-custom py-12">
    <!-- Page Header -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8">
      <div>
        <h1 class="text-4xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-2">Work</h1>
        <p class="text-gray-600 dark:text-gray-400">Professional experience, skills, and projects</p>
      </div>
      <div class="flex gap-3 mt-4 md:mt-0">
        <a 
          href="/resume/Bryant_Hayes_Resume.pdf" 
          download
          class="btn-primary no-print"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          Download PDF
        </a>
        <button 
          onclick="window.print()"
          class="btn-ghost no-print"
        >
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
          </svg>
          Print
        </button>
      </div>
    </div>

    <!-- Resume Content -->
    <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg dark:shadow-gray-900/50 p-8 md:p-12">
      <ResumeViewer client:load resumeData={resumeData} />
    </div>

  </div>
</BaseLayout>