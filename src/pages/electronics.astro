---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Electronics" 
  description="DIY projects and circuit design for practical applications"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Electronics
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        DIY projects, circuit design, and microcontroller programming. 
        Building practical solutions with Arduino, sensors, and custom PCBs.
      </p>
    </div>

    <div class="text-center">
      <div class="w-32 h-32 mx-auto mb-8 rounded-full bg-gray-100 flex items-center justify-center">
        <span class="text-6xl opacity-60">⚡</span>
      </div>
      <p class="text-gray-600 mb-8">
        Project documentation and circuit designs coming soon.
      </p>
      <a href="/contact" class="btn-primary">
        Discuss Projects
      </a>
    </div>
  </div>
</BaseLayout>