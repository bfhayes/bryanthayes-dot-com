---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectTile from '@/components/projects/ProjectTile.astro';
import WorkInProgress from '@/components/projects/WorkInProgress.astro';

// Get all engineering projects from content collections
const allProjects = await getCollection('engineering', ({ data }) => !data.draft && !data.hidden);
---

<BaseLayout 
  title="Engineering" 
  description="Software development, embedded systems, and circuit design projects"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-4">
        Engineering
      </h1>
      <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
        Building software applications and hardware solutions. From full-stack web development 
        to embedded systems and circuit design with Arduino and custom PCBs.
      </p>
    </div>

    {allProjects.length > 0 ? (
      <!-- Projects Grid -->
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {allProjects.map((project) => (
            <ProjectTile project={project} category="engineering" />
          ))}
        </div>
      </section>
    ) : (
      <section class="mb-16">
        <WorkInProgress category="engineering" />
      </section>
    )}

    <!-- Links Section -->
    <section class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 text-center">
      <h2 class="text-xl font-serif font-semibold mb-3 text-gray-900 dark:text-gray-100">Explore My Engineering Work</h2>
      <p class="text-base mb-6 text-gray-600 dark:text-gray-300">
        Check out my open source projects and professional development experience.
      </p>
      <div class="flex gap-3 justify-center">
        <a href="https://github.com/bfhayes" target="_blank" rel="noopener" class="btn-primary text-sm px-6 py-2">
          View GitHub
        </a>
        <a href="/work" class="btn-secondary text-sm px-6 py-2">
          Professional Work
        </a>
      </div>
    </section>
  </div>
</BaseLayout>