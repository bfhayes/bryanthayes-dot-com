---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Programming" 
  description="Personal projects and open-source contributions"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Programming
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Personal projects, open-source contributions, and experimental code. 
        Exploring new technologies and building tools that solve real problems.
      </p>
    </div>

    <div class="text-center">
      <div class="w-32 h-32 mx-auto mb-8 rounded-full bg-gray-100 flex items-center justify-center">
        <span class="text-6xl opacity-60">💻</span>
      </div>
      <p class="text-gray-600 mb-8">
        Personal programming projects and code examples coming soon.
      </p>
      <div class="flex gap-4 justify-center">
        <a href="https://github.com/bryanthayes" target="_blank" rel="noopener" class="btn-primary">
          View GitHub
        </a>
        <a href="/work" class="btn-secondary">
          Professional Work
        </a>
      </div>
    </div>
  </div>
</BaseLayout>