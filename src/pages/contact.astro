---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PageHeader from '../components/PageHeader.astro';
import Card from '../components/Card.astro';
import Button from '../components/Button.astro';
import ContactForm from '../components/ContactForm.jsx';
import { getPageContent, getSiteConfig } from '../lib/content';

const pageData = await getPageContent('contact');
const siteData = await getSiteConfig();

const { Content } = await pageData.render();

const breadcrumb = [
  { label: 'Home', href: '/' },
  { label: 'Contact' }
];
---

<Base 
  title={pageData.data.title}
  description={pageData.data.description}
>
  <Section container={false} background="subtle" padding="small">
    <div class="container">
      <PageHeader 
        title="Get in Touch"
        subtitle="Ready to start your healing journey? I'm here to support you every step of the way."
        breadcrumb={breadcrumb}
      />
    </div>
  </Section>

  <!-- Contact Methods -->
  <Section>
    <div class="grid lg:grid-cols-3 gap-8 mb-12">
      <!-- Phone -->
      <Card hover class="text-center">
        <div class="w-12 h-12 bg-brand-bg rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-900 mb-2">Call or Text</h3>
        <p class="text-neutral-600 mb-4">
          <a href={`tel:${siteData.phone.replace(/\D/g, '')}`} class="text-brand-700 hover:text-brand-800 font-medium">
            {siteData.phone}
          </a>
        </p>
        <p class="text-sm text-neutral-500">
          Typically respond within a few hours during business days
        </p>
      </Card>

      <!-- Email -->
      <Card hover class="text-center">
        <div class="w-12 h-12 bg-brand-bg rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-brand-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-900 mb-2">Email</h3>
        <p class="text-neutral-600 mb-4">
          <a href={`mailto:${siteData.email}`} class="text-brand-700 hover:text-brand-800 font-medium">
            {siteData.email}
          </a>
        </p>
        <p class="text-sm text-neutral-500">
          I aim to respond within 24 hours during business days
        </p>
      </Card>

      <!-- Free Consultation -->
      <Card hover class="text-center border-brand-300 bg-brand-50">
        <div class="w-12 h-12 bg-brand-500 rounded-full flex items-center justify-center mx-auto mb-4">
          <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
        </div>
        <h3 class="text-lg font-semibold text-neutral-900 mb-2">Free Consultation</h3>
        <p class="text-neutral-600 mb-4">
          15-minute phone call to discuss your needs and see if we're a good fit
        </p>
        <p class="text-sm text-brand-700 font-medium">No obligation required</p>
      </Card>
    </div>
  </Section>

  <!-- Contact Form and Info -->
  <Section background="accent">
    <div class="grid lg:grid-cols-2 gap-12">
      <!-- Contact Form -->
      <div>
        <h2 class="text-2xl font-bold text-neutral-900 mb-6">
          Send a Message
        </h2>
        
        <div class="bg-white rounded-2xl p-6 lg:p-8 shadow-sm border border-neutral-200">
          <ContactForm client:load />
        </div>
      </div>

      <!-- Contact Information -->
      <div class="space-y-8">
        <div>
          <h2 class="text-2xl font-bold text-neutral-900 mb-6">
            Location & Hours
          </h2>
          
          <!-- Practice Information -->
          <Card class="mb-6">
            <h3 class="font-semibold text-neutral-900 mb-3">Practice Information</h3>
            <div class="text-neutral-600 space-y-1">
              {siteData.practice_type && <p class="font-medium">{siteData.practice_type}</p>}
              {siteData.serving_areas && <p>{siteData.serving_areas}</p>}
              {siteData.address && (
                <>
                  <p>{siteData.address.street}</p>
                  <p>{siteData.address.city}, {siteData.address.state} {siteData.address.zip}</p>
                  <div class="mt-3 text-sm text-neutral-500">
                    <p>Free parking available</p>
                    <p>Elevator access and ADA-compliant facilities</p>
                  </div>
                </>
              )}
            </div>
          </Card>

          <!-- Office Hours -->
          <Card class="mb-6">
            <h3 class="font-semibold text-neutral-900 mb-3">Office Hours</h3>
            <div class="text-neutral-600 space-y-1">
              <p>{siteData.hours.weekdays}</p>
              <p>{siteData.hours.weekend}</p>
            </div>
            <p class="text-sm text-neutral-500 mt-3">
              Weekend and evening appointments may be available upon request
            </p>
          </Card>

          <!-- Telehealth -->
          <Card>
            <h3 class="font-semibold text-neutral-900 mb-3">Telehealth Services</h3>
            <p class="text-neutral-600 mb-3">
              Secure video therapy sessions available to clients throughout Oregon
            </p>
            <div class="text-sm text-neutral-500">
              <p>• HIPAA-compliant video platform</p>
              <p>• Convenient and private</p>
              <p>• Same quality of care as in-person sessions</p>
            </div>
          </Card>
        </div>

        <!-- What to Expect -->
        <div>
          <h3 class="text-xl font-semibold text-neutral-900 mb-4">
            What to Expect
          </h3>
          <div class="space-y-4">
            {[
              {
                step: 'Initial Contact',
                description: 'Call or email to express interest in therapy'
              },
              {
                step: 'Brief Consultation',
                description: 'Free 15-minute conversation to discuss your needs and answer questions'
              },
              {
                step: 'First Session',
                description: 'Schedule your first 50-minute session if we decide to work together'
              },
              {
                step: 'Ongoing Support',
                description: 'Work together at a pace that feels right for you'
              }
            ].map((item, index) => (
              <div class="flex gap-3">
                <div class="w-6 h-6 bg-brand-500 text-white rounded-full flex items-center justify-center text-xs font-bold flex-shrink-0 mt-0.5">
                  {index + 1}
                </div>
                <div>
                  <p class="font-medium text-neutral-900">{item.step}</p>
                  <p class="text-sm text-neutral-600">{item.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </Section>

  <!-- Important Notes -->
  <Section>
    <div class="max-w-4xl mx-auto">
      <h2 class="text-2xl font-bold text-neutral-900 mb-8 text-center">
        Important Information
      </h2>
      
      <div class="grid md:grid-cols-2 gap-6">
        <!-- Confidentiality Notice -->
        <Card class="border-amber-200 bg-amber-50">
          <div class="flex gap-3">
            <div class="w-6 h-6 text-amber-600 flex-shrink-0 mt-0.5">
              <svg fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M8.257 3.099c.765-1.36 2.722-1.36 3.486 0l5.58 9.92c.75 1.334-.213 2.98-1.742 2.98H4.42c-1.53 0-2.493-1.646-1.743-2.98l5.58-9.92zM11 13a1 1 0 11-2 0 1 1 0 012 0zm-1-8a1 1 0 00-1 1v3a1 1 0 002 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-amber-800 mb-2">Confidentiality Notice</h3>
              <p class="text-sm text-amber-700">
                {siteData.disclaimers.phi}
              </p>
            </div>
          </div>
        </Card>

        <!-- Crisis Resources -->
        <Card class="border-red-200 bg-red-50">
          <div class="flex gap-3">
            <div class="w-6 h-6 text-red-600 flex-shrink-0 mt-0.5">
              <svg fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold text-red-800 mb-2">Crisis Support</h3>
              <p class="text-sm text-red-700 mb-3">
                {siteData.disclaimers.crisis}
              </p>
              <div class="space-y-1">
                <p class="text-sm">
                  <a href="tel:988" class="text-red-800 font-medium hover:underline">
                    988 - Suicide & Crisis Lifeline
                  </a>
                </p>
                <p class="text-sm">
                  <a href="tel:911" class="text-red-800 font-medium hover:underline">
                    911 - Emergency Services
                  </a>
                </p>
              </div>
            </div>
          </div>
        </Card>
      </div>
    </div>
  </Section>

  <!-- Final CTA -->
  <Section background="subtle">
    <div class="text-center max-w-2xl mx-auto">
      <h2 class="text-3xl font-bold text-neutral-900 mb-6">
        Ready to Take the First Step?
      </h2>
      <p class="text-lg text-neutral-600 mb-8">
        I understand that reaching out for therapy can feel vulnerable, and I'm honored that 
        you're considering me as part of your support system. I look forward to connecting with you soon.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <Button href={`tel:${siteData.phone.replace(/\D/g, '')}`} variant="primary">
          Call {siteData.phone}
        </Button>
        <Button href={`mailto:${siteData.email}`} variant="outline">
          Send Email
        </Button>
      </div>
    </div>
  </Section>
</Base>