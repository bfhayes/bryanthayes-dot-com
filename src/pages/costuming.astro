---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectTile from '@/components/projects/ProjectTile.astro';
import WorkInProgress from '@/components/projects/WorkInProgress.astro';

// Get all costuming projects from content collections
const allProjects = await getCollection('costuming', ({ data }) => !data.draft && !data.hidden);
---

<BaseLayout 
  title="Costuming" 
  description="Halloween costumes, cosplay, and character design"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Costuming
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Creating custom Halloween costumes and cosplay outfits. From character research 
        and design to pattern making, prop fabrication, and bringing ideas to life.
      </p>
    </div>

    {allProjects.length > 0 ? (
      <!-- Projects Grid -->
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {allProjects.map((project) => (
            <ProjectTile project={project} category="costuming" />
          ))}
        </div>
      </section>
    ) : (
      <section class="mb-16">
        <WorkInProgress category="costuming" />
      </section>
    )}

    <!-- Commission -->
    <section class="bg-gray-50 border border-gray-200 rounded-lg p-6 text-center">
      <h2 class="text-xl font-serif font-semibold mb-3 text-gray-900">Need a Custom Costume?</h2>
      <p class="text-base mb-6 text-gray-600">
        Let's create the perfect costume for your character or event.
      </p>
      <a href="/contact" class="btn-primary text-sm px-6 py-2">
        Discuss Custom Costumes
      </a>
    </section>
  </div>
</BaseLayout>