---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Costuming" 
  description="Halloween costumes, cosplay, and character design"
>
  <div class="container-custom py-12">
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Costuming
      </h1>
      <p class="text-xl text-gray-600 max-w-3xl mx-auto">
        Creating custom Halloween costumes and cosplay outfits. From character research 
        and design to pattern making, prop fabrication, and bringing ideas to life.
      </p>
    </div>

    <div class="text-center">
      <div class="w-32 h-32 mx-auto mb-8 rounded-full bg-gray-100 flex items-center justify-center">
        <span class="text-6xl opacity-60">🎭</span>
      </div>
      <p class="text-gray-600 mb-8">
        Costume portfolio and project documentation coming soon.
      </p>
      <a href="/contact" class="btn-primary">
        Discuss Custom Costumes
      </a>
    </div>
  </div>
</BaseLayout>