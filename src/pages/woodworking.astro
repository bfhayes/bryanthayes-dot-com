---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import ProjectTile from '@/components/projects/ProjectTile.astro';
import WorkInProgress from '@/components/projects/WorkInProgress.astro';

// Get all woodworking projects from content collections
const allProjects = await getCollection('woodworking', ({ data }) => !data.draft && !data.hidden);

const tools = [
  { category: 'Hand Tools', items: ['Chisels', 'Hand planes', 'Marking gauge', 'Dovetail saw'] },
  { category: 'Power Tools', items: ['Table saw', 'Router', 'Orbital sander', 'Drill press'] },
  { category: 'Measuring', items: ['Combination square', 'Calipers', 'Rulers', 'Pencils'] },
  { category: 'Finishing', items: ['Brushes', 'Scrapers', 'Sandpaper', 'Steel wool'] }
];

---

<BaseLayout 
  title="Woodworking" 
  description="Explore Bryant Hayes' woodworking projects featuring furniture and handcrafted pieces"
>
  <div class="container-custom py-12">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 dark:text-gray-100 mb-4">
        Woodworking
      </h1>
      <p class="text-xl text-gray-700 dark:text-gray-300 max-w-3xl mx-auto">
        Building useful stuff from wood. Each project teaches me something new about working with my hands.
      </p>
    </div>

    <!-- Projects Grid -->
    {allProjects.length > 0 ? (
      <section class="mb-16">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {allProjects.map((project) => (
            <ProjectTile project={project} category="woodworking" />
          ))}
        </div>
      </section>
    ) : (
      <section class="mb-16">
        <WorkInProgress category="woodworking" />
      </section>
    )}


    <!-- Commission -->
    <section class="bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-6 text-center">
      <h2 class="text-xl font-serif font-semibold mb-3 text-gray-900 dark:text-gray-100">Interested in Custom Work?</h2>
      <p class="text-base mb-6 text-gray-600 dark:text-gray-300">
        Let's discuss your custom woodworking project.
      </p>
      <a href="/contact" class="btn-primary text-sm px-6 py-2">
        Get In Touch
      </a>
    </section>
  </div>
</BaseLayout>