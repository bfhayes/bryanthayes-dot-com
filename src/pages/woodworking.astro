---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getAllProjects } from '@/data/woodworking-projects';

// Get all woodworking projects from the data file
const allProjects = getAllProjects();
const projects = allProjects.map(project => ({
  title: project.title,
  description: project.description,
  image: project.heroImage,
  difficulty: project.difficulty,
  duration: project.duration,
  materials: project.materials,
  link: `/woodworking/${project.slug}`
}));

const tools = [
  { category: 'Hand Tools', items: ['Chisels', 'Hand planes', 'Marking gauge', 'Dovetail saw'] },
  { category: 'Power Tools', items: ['Table saw', 'Router', 'Orbital sander', 'Drill press'] },
  { category: 'Measuring', items: ['Combination square', 'Calipers', 'Rulers', 'Pencils'] },
  { category: 'Finishing', items: ['Brushes', 'Scrapers', 'Sandpaper', 'Steel wool'] }
];

---

<BaseLayout 
  title="Woodworking" 
  description="Explore Bryant Hayes' woodworking projects featuring furniture and handcrafted pieces"
>
  <div class="container-custom py-12">
    <!-- Hero Section -->
    <div class="text-center mb-16">
      <h1 class="text-4xl lg:text-6xl font-serif font-bold text-gray-900 mb-4">
        Woodworking
      </h1>
      <p class="text-xl text-gray-700 max-w-3xl mx-auto">
        Creating functional art from raw timber. Each piece tells a story of grain, 
        joinery, and the timeless craft of working with wood.
      </p>
    </div>

    <!-- Projects Grid -->
    <section class="mb-16">
      <h2 class="text-3xl font-serif font-semibold text-gray-900 mb-8 text-center">Recent Projects</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {projects.map((project) => (
          <a href={project.link} class="group">
            <article class="card overflow-hidden hover:shadow-xl transition-all duration-300">
              <div class="aspect-w-16 aspect-h-12 bg-gradient-to-br from-pale-dogwood/20 to-rose-quartz/20 overflow-hidden">
                <div class="w-full h-48 bg-gradient-to-br from-pale-dogwood/30 to-rose-quartz/30 flex items-center justify-center group-hover:scale-105 transition-transform duration-300">
                  <span class="text-4xl opacity-60">🪵</span>
                </div>
              </div>
              <div class="p-6">
                <h3 class="text-xl font-serif font-semibold text-gray-900 mb-2 group-hover:text-blue-600 transition-colors">
                  {project.title}
                </h3>
                <p class="text-gray-600 mb-4 text-sm">
                  {project.description}
                </p>
                
                <div class="flex justify-between items-center mb-3">
                  <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">
                    {project.difficulty}
                  </span>
                  <span class="text-xs text-gray-600">
                    {project.duration}
                  </span>
                </div>

                <div class="flex flex-wrap gap-1">
                  {project.materials.slice(0, 2).map((material) => (
                    <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded">
                      {material}
                    </span>
                  ))}
                  {project.materials.length > 2 && (
                    <span class="text-xs px-2 py-1 bg-gray-200 text-gray-700 rounded">
                      +{project.materials.length - 2} more
                    </span>
                  )}
                </div>
              </div>
            </article>
          </a>
        ))}
      </div>
    </section>


    <!-- Commission -->
    <section class="bg-gray-900 rounded-2xl p-12 text-white text-center">
      <h2 class="text-3xl font-serif font-bold mb-4 text-white">Interested in Custom Work?</h2>
      <p class="text-lg mb-8 text-gray-100">
        Let's discuss your custom woodworking project.
      </p>
      <a href="/contact" class="btn-primary">
        Get In Touch
      </a>
    </section>
  </div>
</BaseLayout>