{
  "$ref": "#/definitions/costuming",
  "definitions": {
    "costuming": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "publishDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "heroImage": {
          "type": "string"
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "fileSize": {
                "type": "string"
              },
              "fileType": {
                "type": "string",
                "enum": [
                  "pdf",
                  "svg",
                  "zip",
                  "jpg",
                  "png",
                  "dwg",
                  "stl",
                  "other"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "pattern",
                  "template",
                  "instructions",
                  "reference",
                  "source"
                ]
              }
            },
            "required": [
              "title",
              "filename",
              "fileType"
            ],
            "additionalProperties": false
          }
        },
        "type": {
          "type": "string",
          "enum": [
            "halloween",
            "cosplay",
            "historical",
            "fantasy",
            "theatrical"
          ]
        },
        "character": {
          "type": "string"
        },
        "source_material": {
          "type": "string"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "Beginner",
            "Intermediate",
            "Advanced"
          ]
        },
        "duration": {
          "type": "string"
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "techniques": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "size": {
          "type": "string"
        },
        "budget": {
          "type": "number"
        },
        "accessories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "makeup_notes": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "publishDate",
        "heroImage",
        "gallery",
        "type",
        "difficulty",
        "duration",
        "materials"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}