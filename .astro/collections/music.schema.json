{
  "$ref": "#/definitions/music",
  "definitions": {
    "music": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "publishDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "heroImage": {
          "type": "string"
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "fileSize": {
                "type": "string"
              },
              "fileType": {
                "type": "string",
                "enum": [
                  "pdf",
                  "svg",
                  "zip",
                  "jpg",
                  "png",
                  "dwg",
                  "stl",
                  "other"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "pattern",
                  "template",
                  "instructions",
                  "reference",
                  "source"
                ]
              }
            },
            "required": [
              "title",
              "filename",
              "fileType"
            ],
            "additionalProperties": false
          }
        },
        "type": {
          "type": "string",
          "enum": [
            "composition",
            "cover",
            "arrangement",
            "recording"
          ]
        },
        "genre": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "instruments": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration": {
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "tempo": {
          "type": "string"
        },
        "audioFile": {
          "type": "string"
        },
        "sheetMusic": {
          "type": "string"
        },
        "sheetMusicFormat": {
          "type": "string",
          "enum": [
            "alphaTex",
            "musicxml",
            "gp"
          ]
        },
        "tabs": {
          "type": "string"
        },
        "tuning": {
          "type": "string"
        },
        "capo": {
          "type": "string"
        },
        "inspiration": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "publishDate",
        "heroImage",
        "gallery",
        "type",
        "genre",
        "instruments"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}