{
  "$ref": "#/definitions/woodworking",
  "definitions": {
    "woodworking": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "publishDate": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "integer",
              "format": "unix-time"
            }
          ]
        },
        "heroImage": {
          "type": "string"
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "hidden": {
          "type": "boolean",
          "default": false
        },
        "downloads": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "filename": {
                "type": "string"
              },
              "fileSize": {
                "type": "string"
              },
              "fileType": {
                "type": "string",
                "enum": [
                  "pdf",
                  "svg",
                  "zip",
                  "jpg",
                  "png",
                  "dwg",
                  "stl",
                  "other"
                ]
              },
              "category": {
                "type": "string",
                "enum": [
                  "pattern",
                  "template",
                  "instructions",
                  "reference",
                  "source"
                ]
              }
            },
            "required": [
              "title",
              "filename",
              "fileType"
            ],
            "additionalProperties": false
          }
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "Beginner",
            "Intermediate",
            "Advanced"
          ]
        },
        "duration": {
          "type": "string"
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tools": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dimensions": {
          "type": "string"
        },
        "woodSpecies": {
          "type": "string"
        },
        "finish": {
          "type": "string"
        },
        "joinery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cost": {
          "type": "object",
          "properties": {
            "materials": {
              "type": "number"
            },
            "total": {
              "type": "number"
            }
          },
          "additionalProperties": false
        },
        "modelUrl": {
          "type": "string"
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "publishDate",
        "heroImage",
        "gallery",
        "difficulty",
        "duration",
        "materials",
        "tools"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}